<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- アクアモードの色：水色のグラデーションの上に、半透明の白いパネルを重ねる（キーは Colors.Dark.xaml と揃える） -->
    <LinearGradientBrush x:Key="BgBrush" StartPoint="0,0" EndPoint="0.35,1">
        <GradientStop Color="#F2FBFF" Offset="0" />
        <GradientStop Color="#C4E9FB" Offset="0.45" />
        <GradientStop Color="#8ED3F5" Offset="1" />
    </LinearGradientBrush>
    <!-- 設定などの別ウィンドウの背景（下に何も無いので不透明） -->
    <LinearGradientBrush x:Key="DialogBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F7FCFF" Offset="0" />
        <GradientStop Color="#DCF2FD" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="PanelBrush" Color="#8CFFFFFF" />
    <SolidColorBrush x:Key="Panel2Brush" Color="#B8FFFFFF" />
    <SolidColorBrush x:Key="Panel3Brush" Color="#D9E6F7FE" />
    <SolidColorBrush x:Key="LineBrush" Color="#99A9D8EE" />
    <SolidColorBrush x:Key="Line2Brush" Color="#8EC7E6" />
    <SolidColorBrush x:Key="TextBrush" Color="#0B3A55" />
    <SolidColorBrush x:Key="SubBrush" Color="#245873" />
    <SolidColorBrush x:Key="MutedBrush" Color="#4D7E98" />
    <SolidColorBrush x:Key="DimBrush" Color="#6F98AE" />
    <!-- アクセントはつやのある青いボタン -->
    <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#7AD3FA" Offset="0" />
        <GradientStop Color="#36AEEA" Offset="0.48" />
        <GradientStop Color="#1693D8" Offset="0.52" />
        <GradientStop Color="#1FA3E8" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentHoverBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#98DEFC" Offset="0" />
        <GradientStop Color="#4DBBF0" Offset="0.48" />
        <GradientStop Color="#26A2E2" Offset="0.52" />
        <GradientStop Color="#34B2F0" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SelectedRowBrush" Color="#CCBFE8FB" />
    <SolidColorBrush x:Key="OkBgBrush" Color="#D6F3E4" />
    <SolidColorBrush x:Key="OkFgBrush" Color="#13804A" />
    <SolidColorBrush x:Key="WarnBgBrush" Color="#FDF1C7" />
    <SolidColorBrush x:Key="WarnFgBrush" Color="#9A5B05" />
    <SolidColorBrush x:Key="ErrBgBrush" Color="#FDE2E2" />
    <SolidColorBrush x:Key="ErrFgBrush" Color="#B91C1C" />
    <!-- 切り替えボタンの選択中（白文字が乗る）-->
    <SolidColorBrush x:Key="SegOnBrush" Color="#2B8DC4" />
    <!-- 入力欄・コンボボックスの地 -->
    <SolidColorBrush x:Key="InputBrush" Color="#E6FFFFFF" />
    <SolidColorBrush x:Key="FooterBrush" Color="#80FFFFFF" />
    <SolidColorBrush x:Key="HeaderRowBrush" Color="#A6E4F5FD" />
    <SolidColorBrush x:Key="HeaderLineBrush" Color="#A3D2EA" />
    <!-- 普通のボタン：上がつやっと光る白いボタン -->
    <LinearGradientBrush x:Key="ButtonBgBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F2FFFFFF" Offset="0" />
        <GradientStop Color="#D9FFFFFF" Offset="0.5" />
        <GradientStop Color="#B3E9F7FE" Offset="0.52" />
        <GradientStop Color="#CCF4FBFF" Offset="1" />
    </LinearGradientBrush>

    <!-- 機種アイコン：丸い水玉にハイライト -->
    <!-- 1 のとき、機種の色で塗った水玉に白いアイコンを重ねる -->
    <sys:Double x:Key="SystemIconFilled">1</sys:Double>
    <CornerRadius x:Key="SystemIconRadius">22</CornerRadius>
    <RadialGradientBrush x:Key="SystemIconBgBrush" GradientOrigin="0.35,0.25" Center="0.45,0.4" RadiusX="0.75" RadiusY="0.75">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#E3F5FE" Offset="0.6" />
        <GradientStop Color="#A9DCF5" Offset="1" />
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="SystemIconGlossBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#CCFFFFFF" Offset="0" />
        <GradientStop Color="#1AFFFFFF" Offset="1" />
    </LinearGradientBrush>

    <!-- テレビ風プレビュー：水色の透き通った縁＋つやのある青い帯 -->
    <LinearGradientBrush x:Key="TvBezelBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F2FBFF" Offset="0" /><GradientStop Color="#BFE6FA" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="TvBezelBorderBrush" Color="#8EC7E6" />
    <LinearGradientBrush x:Key="TvBandBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#7AD3FA" Offset="0" /><GradientStop Color="#36AEEA" Offset="0.48" />
        <GradientStop Color="#1693D8" Offset="0.52" /><GradientStop Color="#1FA3E8" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="TvBandLineBrush" Color="#B3EAFF" />
    <SolidColorBrush x:Key="TvLedOffBrush" Color="#BFE8FB" />
    <SolidColorBrush x:Key="TvLogoBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TvSaveBgBrush" Color="#4D0B6FA8" />
    <SolidColorBrush x:Key="TvSaveBorderBrush" Color="#B3FFFFFF" />
    <!-- ROM情報カード：水色の罫線のリングノート -->
    <sys:String x:Key="MemoHeaderText">memo</sys:String>
    <SolidColorBrush x:Key="MemoBgBrush" Color="#F7FCFF" />
    <SolidColorBrush x:Key="MemoBorderBrush" Color="#B9DDEF" />
    <SolidColorBrush x:Key="MemoLineBrush" Color="#C6E5F4" />
    <SolidColorBrush x:Key="MemoKeyBrush" Color="#5A89A2" />
    <SolidColorBrush x:Key="MemoTextBrush" Color="#1D4559" />
    <SolidColorBrush x:Key="MemoTitleBrush" Color="#0E3447" />
    <SolidColorBrush x:Key="MemoHeaderBrush" Color="#7CA8BE" />
    <SolidColorBrush x:Key="MemoMarginBrush" Color="#86CBEB" />
    <SolidColorBrush x:Key="MemoFoldBrush" Color="#D0ECF9" />
    <!-- 折れた角の外側（パネルが半透明なので欠けさせない） -->
    <SolidColorBrush x:Key="MemoFoldCutBrush" Color="Transparent" />
    <DrawingBrush x:Key="MemoRingBrush" TileMode="Tile" Viewport="0,0,40,24" ViewportUnits="Absolute" Viewbox="0,0,40,24" ViewboxUnits="Absolute" Stretch="None">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H40 V24 H0 Z" />
                <GeometryDrawing Brush="#2E5D75" Geometry="M21,12.5 A4,3 0 1 0 29,12.5 A4,3 0 1 0 21,12.5 Z" />
                <GeometryDrawing Geometry="M3.8,18.2 C1.8,9.2 13.8,4.2 23.8,11.2">
                    <GeometryDrawing.Pen><Pen Brush="#40104060" Thickness="3.2" StartLineCap="Round" EndLineCap="Round" /></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M3,17 C1,8 13,3 23,10">
                    <GeometryDrawing.Pen><Pen Brush="#9DB9C9" Thickness="2.6" StartLineCap="Round" EndLineCap="Round" /></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

</ResourceDictionary>
