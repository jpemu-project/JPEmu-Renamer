<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- アクア：淡い水色に、青のアクセント
         ソフトUI（ニューモーフィズム）：背景とパネルを同じ色にし、明るい影（左上）と暗い影（右下）で浮き上がり・へこみを表す。
         キーは6つのテーマで揃える（Ui/Theme.xaml と Views/*.xaml が DynamicResource で参照する） -->

    <!-- 地の色と、浮き上がり・へこみの影の色 -->
    <Color x:Key="SoftBaseColor">#DCEDF7</Color>
    <Color x:Key="SoftHiColor">#FFFFFF</Color>
    <Color x:Key="SoftLoColor">#A8C8DA</Color>
    <Color x:Key="AccentGlowColor">#1E9BEA</Color>
    <SolidColorBrush x:Key="BgBrush" Color="#DCEDF7" />
    <SolidColorBrush x:Key="DialogBrush" Color="#DCEDF7" />
    <SolidColorBrush x:Key="PanelBrush" Color="#DCEDF7" />
    <SolidColorBrush x:Key="Panel2Brush" Color="#DCEDF7" />
    <SolidColorBrush x:Key="Panel3Brush" Color="#D2E6F2" />
    <SolidColorBrush x:Key="SegGroupBrush" Color="#DCEDF7" />
    <SolidColorBrush x:Key="InputBrush" Color="#DCEDF7" />
    <SolidColorBrush x:Key="FooterBrush" Color="Transparent" />
    <SolidColorBrush x:Key="HeaderRowBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ButtonBgBrush" Color="#DCEDF7" />
    <!-- へこんだ面：左上が少し暗い -->
    <LinearGradientBrush x:Key="SoftInsetBrush" StartPoint="0,0" EndPoint="0.7,1">
        <GradientStop Color="#CBE0EC" Offset="0" /><GradientStop Color="#DCEDF7" Offset="0.45" />
    </LinearGradientBrush>
    <!-- へこんだ面のふち（左上が暗く、右下が明るい） -->
    <LinearGradientBrush x:Key="SoftInsetEdgeBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#A8C8DA" Offset="0" /><GradientStop Color="#FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <!-- 浮き上がった小さな部品のふち（影を使わない軽い浮き上がり。左上が明るく、右下が暗い） -->
    <LinearGradientBrush x:Key="SoftRaisedEdgeBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFF" Offset="0" /><GradientStop Color="#A8C8DA" Offset="1" />
    </LinearGradientBrush>
    <!-- 影 -->
    <DropShadowEffect x:Key="SoftShadowDark" Color="#A8C8DA" Direction="315" ShadowDepth="5" BlurRadius="14" Opacity="1" />
    <DropShadowEffect x:Key="SoftShadowLight" Color="#FFFFFF" Direction="135" ShadowDepth="5" BlurRadius="14" Opacity="1" />
    <DropShadowEffect x:Key="SoftShadowDarkSmall" Color="#A8C8DA" Direction="315" ShadowDepth="3" BlurRadius="8" Opacity="1" />
    <DropShadowEffect x:Key="SoftShadowLightSmall" Color="#FFFFFF" Direction="135" ShadowDepth="3" BlurRadius="8" Opacity="1" />
    <DropShadowEffect x:Key="AccentGlow" Color="#1E9BEA" Direction="270" ShadowDepth="4" BlurRadius="16" Opacity="0.55" />

    <!-- 線と文字 -->
    <SolidColorBrush x:Key="LineBrush" Color="#BFD8E7" />
    <SolidColorBrush x:Key="Line2Brush" Color="#A6C6D9" />
    <SolidColorBrush x:Key="HeaderLineBrush" Color="#BFD8E7" />
    <SolidColorBrush x:Key="TextBrush" Color="#0B3A55" />
    <SolidColorBrush x:Key="SubBrush" Color="#245873" />
    <SolidColorBrush x:Key="MutedBrush" Color="#4D7E98" />
    <SolidColorBrush x:Key="DimBrush" Color="#6F98AE" />

    <!-- アクセント（選んでいるもの・起動ボタン）：グラデーション -->
    <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1E9BEA" Offset="0" /><GradientStop Color="#5ACDF7" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentHoverBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3AAEF2" Offset="0" /><GradientStop Color="#7DDAFA" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#1E9BEA" />
    <LinearGradientBrush x:Key="SegOnBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1E9BEA" Offset="0" /><GradientStop Color="#5ACDF7" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SelectedRowBrush" Color="#C9E1F0" />
    <SolidColorBrush x:Key="SystemSelectedBrush" Color="#DCEDF7" />

    <!-- 状態バッジ -->
    <SolidColorBrush x:Key="OkBgBrush" Color="#D2F0E2" />
    <SolidColorBrush x:Key="OkFgBrush" Color="#13804A" />
    <SolidColorBrush x:Key="WarnBgBrush" Color="#FBEFC9" />
    <SolidColorBrush x:Key="WarnFgBrush" Color="#9A5B05" />
    <SolidColorBrush x:Key="ErrBgBrush" Color="#F8DADA" />
    <SolidColorBrush x:Key="ErrFgBrush" Color="#B91C1C" />

    <!-- 機種アイコン：地の色で小さく浮き上がる -->
    <sys:Double x:Key="SystemIconFilled">0</sys:Double>
    <CornerRadius x:Key="SystemIconRadius">14</CornerRadius>
    <SolidColorBrush x:Key="SystemIconBgBrush" Color="#DCEDF7" />
    <SolidColorBrush x:Key="SystemIconGlossBrush" Color="Transparent" />

    <!-- テレビ風プレビュー：地の色で浮き上がった枠に、へこんだ画面を埋め込む -->
    <SolidColorBrush x:Key="TvBezelBrush" Color="#DCEDF7" />
    <SolidColorBrush x:Key="TvBezelBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TvBandBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TvBandLineBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TvLedOffBrush" Color="#A8C8DA" />
    <SolidColorBrush x:Key="TvLogoBrush" Color="#4D7E98" />
    <SolidColorBrush x:Key="TvSaveBgBrush" Color="#DCEDF7" />
    <SolidColorBrush x:Key="TvSaveBorderBrush" Color="#A6C6D9" />

</ResourceDictionary>
