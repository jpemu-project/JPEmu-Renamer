<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- シック：生成りのベージュに、えんじ色のアクセント
         ソフトUI（ニューモーフィズム）：背景とパネルを同じ色にし、明るい影（左上）と暗い影（右下）で浮き上がり・へこみを表す。
         キーは6つのテーマで揃える（Ui/Theme.xaml と Views/*.xaml が DynamicResource で参照する） -->

    <!-- 地の色と、浮き上がり・へこみの影の色 -->
    <Color x:Key="SoftBaseColor">#ECE3D5</Color>
    <Color x:Key="SoftHiColor">#FFFBF3</Color>
    <Color x:Key="SoftLoColor">#C7B59C</Color>
    <Color x:Key="AccentGlowColor">#9C3B3E</Color>
    <SolidColorBrush x:Key="BgBrush" Color="#ECE3D5" />
    <SolidColorBrush x:Key="DialogBrush" Color="#ECE3D5" />
    <SolidColorBrush x:Key="PanelBrush" Color="#ECE3D5" />
    <SolidColorBrush x:Key="Panel2Brush" Color="#ECE3D5" />
    <SolidColorBrush x:Key="Panel3Brush" Color="#E3D8C8" />
    <SolidColorBrush x:Key="SegGroupBrush" Color="#ECE3D5" />
    <SolidColorBrush x:Key="InputBrush" Color="#ECE3D5" />
    <SolidColorBrush x:Key="FooterBrush" Color="Transparent" />
    <SolidColorBrush x:Key="HeaderRowBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ButtonBgBrush" Color="#ECE3D5" />
    <!-- へこんだ面：左上が少し暗い -->
    <LinearGradientBrush x:Key="SoftInsetBrush" StartPoint="0,0" EndPoint="0.7,1">
        <GradientStop Color="#DDD1BF" Offset="0" /><GradientStop Color="#ECE3D5" Offset="0.45" />
    </LinearGradientBrush>
    <!-- へこんだ面のふち（左上が暗く、右下が明るい） -->
    <LinearGradientBrush x:Key="SoftInsetEdgeBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#C7B59C" Offset="0" /><GradientStop Color="#FFFBF3" Offset="1" />
    </LinearGradientBrush>
    <!-- 浮き上がった小さな部品のふち（影を使わない軽い浮き上がり。左上が明るく、右下が暗い） -->
    <LinearGradientBrush x:Key="SoftRaisedEdgeBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFBF3" Offset="0" /><GradientStop Color="#C7B59C" Offset="1" />
    </LinearGradientBrush>
    <!-- 影 -->
    <DropShadowEffect x:Key="SoftShadowDark" Color="#C7B59C" Direction="315" ShadowDepth="5" BlurRadius="14" Opacity="1" />
    <DropShadowEffect x:Key="SoftShadowLight" Color="#FFFBF3" Direction="135" ShadowDepth="5" BlurRadius="14" Opacity="1" />
    <DropShadowEffect x:Key="SoftShadowDarkSmall" Color="#C7B59C" Direction="315" ShadowDepth="3" BlurRadius="8" Opacity="1" />
    <DropShadowEffect x:Key="SoftShadowLightSmall" Color="#FFFBF3" Direction="135" ShadowDepth="3" BlurRadius="8" Opacity="1" />
    <DropShadowEffect x:Key="AccentGlow" Color="#9C3B3E" Direction="270" ShadowDepth="4" BlurRadius="16" Opacity="0.55" />

    <!-- 線と文字 -->
    <SolidColorBrush x:Key="LineBrush" Color="#D8CBB7" />
    <SolidColorBrush x:Key="Line2Brush" Color="#C4B39B" />
    <SolidColorBrush x:Key="HeaderLineBrush" Color="#D8CBB7" />
    <SolidColorBrush x:Key="TextBrush" Color="#3A2819" />
    <SolidColorBrush x:Key="SubBrush" Color="#5C4632" />
    <SolidColorBrush x:Key="MutedBrush" Color="#8A735C" />
    <SolidColorBrush x:Key="DimBrush" Color="#9B856E" />

    <!-- アクセント（選んでいるもの・起動ボタン）：グラデーション -->
    <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#9C3B3E" Offset="0" /><GradientStop Color="#C66A5C" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentHoverBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#AE4B4C" Offset="0" /><GradientStop Color="#D57F70" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#9C3B3E" />
    <LinearGradientBrush x:Key="SegOnBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#9C3B3E" Offset="0" /><GradientStop Color="#C66A5C" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SelectedRowBrush" Color="#E2D5C3" />
    <SolidColorBrush x:Key="SystemSelectedBrush" Color="#ECE3D5" />

    <!-- 状態バッジ -->
    <SolidColorBrush x:Key="OkBgBrush" Color="#DCEAD3" />
    <SolidColorBrush x:Key="OkFgBrush" Color="#2F6B2A" />
    <SolidColorBrush x:Key="WarnBgBrush" Color="#F2E2B8" />
    <SolidColorBrush x:Key="WarnFgBrush" Color="#7D5408" />
    <SolidColorBrush x:Key="ErrBgBrush" Color="#F0D6D1" />
    <SolidColorBrush x:Key="ErrFgBrush" Color="#8E2323" />

    <!-- 機種アイコン：地の色で小さく浮き上がる -->
    <CornerRadius x:Key="SystemIconRadius">14</CornerRadius>
    <SolidColorBrush x:Key="SystemIconBgBrush" Color="#ECE3D5" />

    <!-- テレビ風プレビュー：地の色で浮き上がった枠に、へこんだ画面を埋め込む -->
    <SolidColorBrush x:Key="TvBezelBrush" Color="#ECE3D5" />
    <SolidColorBrush x:Key="TvBezelBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TvBandBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TvBandLineBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TvLedOffBrush" Color="#C7B59C" />
    <SolidColorBrush x:Key="TvLogoBrush" Color="#8A735C" />
    <SolidColorBrush x:Key="TvSaveBgBrush" Color="#ECE3D5" />
    <SolidColorBrush x:Key="TvSaveBorderBrush" Color="#C4B39B" />

</ResourceDictionary>
