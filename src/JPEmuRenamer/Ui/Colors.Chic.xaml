<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- シックの色：ウォルナットの木目に、生成り色のパネルと深いワインレッド（キーは Colors.Dark.xaml と揃える） -->
    <!-- 木目：茶色の地に、ゆるく波打つ年輪の線を重ねたタイルを敷き詰める -->
    <DrawingBrush x:Key="BgBrush" TileMode="FlipXY" Viewport="0,0,520,180" ViewportUnits="Absolute" Viewbox="0,0,520,180" ViewboxUnits="Absolute" Stretch="None">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M0,0 H520 V180 H0 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#6B4428" Offset="0" />
                            <GradientStop Color="#7A4F2F" Offset="0.35" />
                            <GradientStop Color="#5E3B22" Offset="0.7" />
                            <GradientStop Color="#714A2C" Offset="1" />
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M0,18 C120,8 220,30 330,16 C420,6 480,20 520,14 M0,52 C90,62 200,40 300,56 C400,70 460,48 520,54 M0,96 C140,84 240,108 360,92 C440,82 490,98 520,94 M0,138 C110,148 230,124 340,140 C430,152 480,132 520,136 M0,168 C150,160 260,176 380,164 C450,158 500,170 520,166">
                    <GeometryDrawing.Pen><Pen Brush="#55301A0C" Thickness="2.2" /></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M0,34 C130,26 210,44 320,32 C410,24 470,38 520,32 M0,76 C100,84 210,66 310,78 C410,90 470,72 520,76 M0,118 C140,108 250,128 370,114 C450,106 495,120 520,116 M0,154 C120,162 240,144 350,156 C440,164 485,150 520,152">
                    <GeometryDrawing.Pen><Pen Brush="#26E8C59A" Thickness="1.4" /></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M0,8 C160,2 280,14 400,6 C460,2 500,8 520,6 M0,64 C150,70 260,58 380,66 C460,72 500,62 520,64 M0,126 C130,120 260,134 390,124 C470,118 505,128 520,126">
                    <GeometryDrawing.Pen><Pen Brush="#40261208" Thickness="0.9" /></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <!-- 設定などの別ウィンドウの背景（下に何も無いので不透明な生成り色） -->
    <LinearGradientBrush x:Key="DialogBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F7F1E6" Offset="0" />
        <GradientStop Color="#EADFCB" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="PanelBrush" Color="#E6F5EEE1" />
    <SolidColorBrush x:Key="Panel2Brush" Color="#F0F9F4EA" />
    <SolidColorBrush x:Key="Panel3Brush" Color="#E8E6D9C3" />
    <SolidColorBrush x:Key="LineBrush" Color="#B3CDBB9A" />
    <SolidColorBrush x:Key="Line2Brush" Color="#B9A27E" />
    <SolidColorBrush x:Key="TextBrush" Color="#3A2819" />
    <SolidColorBrush x:Key="SubBrush" Color="#574030" />
    <SolidColorBrush x:Key="MutedBrush" Color="#7C6450" />
    <SolidColorBrush x:Key="DimBrush" Color="#968069" />
    <!-- アクセントは深いワインレッド -->
    <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#9C3B3E" Offset="0" />
        <GradientStop Color="#7A2A2E" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentHoverBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#AD4A4D" Offset="0" />
        <GradientStop Color="#8A3236" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SelectedRowBrush" Color="#E6EBD5D0" />
    <SolidColorBrush x:Key="OkBgBrush" Color="#DCEBD5" />
    <SolidColorBrush x:Key="OkFgBrush" Color="#2F6B2A" />
    <SolidColorBrush x:Key="WarnBgBrush" Color="#F3E2B8" />
    <SolidColorBrush x:Key="WarnFgBrush" Color="#7D5408" />
    <SolidColorBrush x:Key="ErrBgBrush" Color="#F1D6D1" />
    <SolidColorBrush x:Key="ErrFgBrush" Color="#8E2323" />
    <!-- 切り替えボタンの選択中（白文字が乗る）-->
    <SolidColorBrush x:Key="SegOnBrush" Color="#6B4A33" />
    <!-- 切り替えボタンを並べた枠の地 -->
    <SolidColorBrush x:Key="SegGroupBrush" Color="#EADFCB" />
    <!-- 入力欄・コンボボックスの地 -->
    <SolidColorBrush x:Key="InputBrush" Color="#FBF7F0" />
    <SolidColorBrush x:Key="FooterBrush" Color="#E6EDE3D2" />
    <SolidColorBrush x:Key="HeaderRowBrush" Color="#EFE5D3" />
    <SolidColorBrush x:Key="HeaderLineBrush" Color="#CDBB9A" />
    <!-- 普通のボタンの地 -->
    <LinearGradientBrush x:Key="ButtonBgBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FBF7F0" Offset="0" />
        <GradientStop Color="#EFE6D6" Offset="1" />
    </LinearGradientBrush>

    <!-- 機種アイコン：生成り色の角丸 -->
    <!-- 1 のとき、機種の色で塗った水玉に白いアイコンを重ねる -->
    <sys:Double x:Key="SystemIconFilled">0</sys:Double>
    <CornerRadius x:Key="SystemIconRadius">10</CornerRadius>
    <SolidColorBrush x:Key="SystemIconBgBrush" Color="#FBF7F0" />
    <SolidColorBrush x:Key="SystemIconGlossBrush" Color="Transparent" />

    <!-- テレビ風プレビュー：木の縁＋真鍮の帯 -->
    <LinearGradientBrush x:Key="TvBezelBrush" StartPoint="0,0" EndPoint="1,0.15" SpreadMethod="Reflect">
        <GradientStop Color="#5A3820" Offset="0" />
        <GradientStop Color="#6E4628" Offset="0.08" />
        <GradientStop Color="#523319" Offset="0.16" />
        <GradientStop Color="#6A4326" Offset="0.27" />
        <GradientStop Color="#4E3018" Offset="0.4" />
        <GradientStop Color="#674024" Offset="0.55" />
        <GradientStop Color="#55361D" Offset="0.7" />
        <GradientStop Color="#6C4527" Offset="0.85" />
        <GradientStop Color="#58371E" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="TvBezelBorderBrush" Color="#3B2412" />
    <LinearGradientBrush x:Key="TvBandBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E6CC92" Offset="0" /><GradientStop Color="#C9A660" Offset="0.5" />
        <GradientStop Color="#AD8743" Offset="0.52" /><GradientStop Color="#C19C55" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="TvBandLineBrush" Color="#F3E2B5" />
    <SolidColorBrush x:Key="TvLedOffBrush" Color="#7E6236" />
    <SolidColorBrush x:Key="TvLogoBrush" Color="#3A2819" />
    <SolidColorBrush x:Key="TvSaveBgBrush" Color="#EAD7A8" />
    <SolidColorBrush x:Key="TvSaveBorderBrush" Color="#8C6B33" />
    <!-- ROM情報カード：クラフト紙のノート -->
    <sys:String x:Key="MemoHeaderText">memo</sys:String>
    <SolidColorBrush x:Key="MemoBgBrush" Color="#E8DAC0" />
    <SolidColorBrush x:Key="MemoBorderBrush" Color="#C4AE87" />
    <SolidColorBrush x:Key="MemoLineBrush" Color="#CDB991" />
    <SolidColorBrush x:Key="MemoKeyBrush" Color="#7A6247" />
    <SolidColorBrush x:Key="MemoTextBrush" Color="#3A2819" />
    <SolidColorBrush x:Key="MemoTitleBrush" Color="#2C1D10" />
    <SolidColorBrush x:Key="MemoHeaderBrush" Color="#977D5E" />
    <SolidColorBrush x:Key="MemoMarginBrush" Color="#B0614A" />
    <SolidColorBrush x:Key="MemoFoldBrush" Color="#D2BE98" />
    <!-- 折れた角の外側（パネルが半透明なので欠けさせない） -->
    <SolidColorBrush x:Key="MemoFoldCutBrush" Color="Transparent" />
    <DrawingBrush x:Key="MemoRingBrush" TileMode="Tile" Viewport="0,0,40,24" ViewportUnits="Absolute" Viewbox="0,0,40,24" ViewboxUnits="Absolute" Stretch="None">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H40 V24 H0 Z" />
                <GeometryDrawing Brush="#3A2819" Geometry="M21,12.5 A4,3 0 1 0 29,12.5 A4,3 0 1 0 21,12.5 Z" />
                <GeometryDrawing Geometry="M3.8,18.2 C1.8,9.2 13.8,4.2 23.8,11.2">
                    <GeometryDrawing.Pen><Pen Brush="#55301A0C" Thickness="3.2" StartLineCap="Round" EndLineCap="Round" /></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M3,17 C1,8 13,3 23,10">
                    <GeometryDrawing.Pen><Pen Brush="#C9A660" Thickness="2.6" StartLineCap="Round" EndLineCap="Round" /></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

</ResourceDictionary>
