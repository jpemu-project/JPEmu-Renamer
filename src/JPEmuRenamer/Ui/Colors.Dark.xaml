<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ダーク：暗い青灰色に、水色から緑のアクセント
         ソフトUI（ニューモーフィズム）：背景とパネルを同じ色にし、明るい影（左上）と暗い影（右下）で浮き上がり・へこみを表す。
         キーは6つのテーマで揃える（Ui/Theme.xaml と Views/*.xaml が DynamicResource で参照する） -->

    <!-- 地の色と、浮き上がり・へこみの影の色 -->
    <Color x:Key="SoftBaseColor">#262B34</Color>
    <Color x:Key="SoftHiColor">#30363F</Color>
    <Color x:Key="SoftLoColor">#1A1E25</Color>
    <Color x:Key="AccentGlowColor">#1597AB</Color>
    <SolidColorBrush x:Key="BgBrush" Color="#262B34" />
    <SolidColorBrush x:Key="DialogBrush" Color="#262B34" />
    <SolidColorBrush x:Key="PanelBrush" Color="#262B34" />
    <SolidColorBrush x:Key="Panel2Brush" Color="#262B34" />
    <SolidColorBrush x:Key="Panel3Brush" Color="#2C323C" />
    <SolidColorBrush x:Key="SegGroupBrush" Color="#262B34" />
    <SolidColorBrush x:Key="InputBrush" Color="#262B34" />
    <SolidColorBrush x:Key="FooterBrush" Color="Transparent" />
    <SolidColorBrush x:Key="HeaderRowBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ButtonBgBrush" Color="#262B34" />
    <!-- へこんだ面：左上が少し暗い -->
    <LinearGradientBrush x:Key="SoftInsetBrush" StartPoint="0,0" EndPoint="0.7,1">
        <GradientStop Color="#20242C" Offset="0" /><GradientStop Color="#262B34" Offset="0.45" />
    </LinearGradientBrush>
    <!-- へこんだ面のふち（左上が暗く、右下が明るい） -->
    <LinearGradientBrush x:Key="SoftInsetEdgeBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1A1E25" Offset="0" /><GradientStop Color="#30363F" Offset="1" />
    </LinearGradientBrush>
    <!-- 浮き上がった小さな部品のふち（影を使わない軽い浮き上がり。左上が明るく、右下が暗い） -->
    <LinearGradientBrush x:Key="SoftRaisedEdgeBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#30363F" Offset="0" /><GradientStop Color="#1A1E25" Offset="1" />
    </LinearGradientBrush>
    <!-- 影 -->
    <DropShadowEffect x:Key="SoftShadowDark" Color="#1A1E25" Direction="315" ShadowDepth="5" BlurRadius="14" Opacity="1" />
    <DropShadowEffect x:Key="SoftShadowLight" Color="#30363F" Direction="135" ShadowDepth="5" BlurRadius="14" Opacity="1" />
    <DropShadowEffect x:Key="SoftShadowDarkSmall" Color="#1A1E25" Direction="315" ShadowDepth="3" BlurRadius="8" Opacity="1" />
    <DropShadowEffect x:Key="SoftShadowLightSmall" Color="#30363F" Direction="135" ShadowDepth="3" BlurRadius="8" Opacity="1" />
    <DropShadowEffect x:Key="AccentGlow" Color="#1597AB" Direction="270" ShadowDepth="4" BlurRadius="16" Opacity="0.55" />

    <!-- 線と文字 -->
    <SolidColorBrush x:Key="LineBrush" Color="#343B46" />
    <SolidColorBrush x:Key="Line2Brush" Color="#414955" />
    <SolidColorBrush x:Key="HeaderLineBrush" Color="#343B46" />
    <SolidColorBrush x:Key="TextBrush" Color="#E3E8F0" />
    <SolidColorBrush x:Key="SubBrush" Color="#B9C2CF" />
    <SolidColorBrush x:Key="MutedBrush" Color="#8C97A8" />
    <SolidColorBrush x:Key="DimBrush" Color="#7C8696" />

    <!-- アクセント（選んでいるもの・起動ボタン）：グラデーション -->
    <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#22B8CF" Offset="0" /><GradientStop Color="#3DD6A0" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentHoverBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3CC6DA" Offset="0" /><GradientStop Color="#58E0AE" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#22B8CF" />
    <LinearGradientBrush x:Key="SegOnBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#22B8CF" Offset="0" /><GradientStop Color="#3DD6A0" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SelectedRowBrush" Color="#2E3540" />
    <SolidColorBrush x:Key="SystemSelectedBrush" Color="#262B34" />

    <!-- 状態バッジ -->
    <SolidColorBrush x:Key="OkBgBrush" Color="#173A2B" />
    <SolidColorBrush x:Key="OkFgBrush" Color="#4ADE9A" />
    <SolidColorBrush x:Key="WarnBgBrush" Color="#3D3412" />
    <SolidColorBrush x:Key="WarnFgBrush" Color="#FACC15" />
    <SolidColorBrush x:Key="ErrBgBrush" Color="#3B1A1C" />
    <SolidColorBrush x:Key="ErrFgBrush" Color="#F87171" />

    <!-- 機種アイコン：地の色で小さく浮き上がる -->
    <sys:Double x:Key="SystemIconFilled">0</sys:Double>
    <CornerRadius x:Key="SystemIconRadius">14</CornerRadius>
    <SolidColorBrush x:Key="SystemIconBgBrush" Color="#262B34" />
    <SolidColorBrush x:Key="SystemIconGlossBrush" Color="Transparent" />

    <!-- テレビ風プレビュー：地の色で浮き上がった枠に、へこんだ画面を埋め込む -->
    <SolidColorBrush x:Key="TvBezelBrush" Color="#262B34" />
    <SolidColorBrush x:Key="TvBezelBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TvBandBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TvBandLineBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TvLedOffBrush" Color="#3A414C" />
    <SolidColorBrush x:Key="TvLogoBrush" Color="#8C97A8" />
    <SolidColorBrush x:Key="TvSaveBgBrush" Color="#262B34" />
    <SolidColorBrush x:Key="TvSaveBorderBrush" Color="#414955" />

</ResourceDictionary>
