<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ピンクの色：やわらかいピンクのグラデーションに、白いパネルとつやのあるピンクのボタン（キーは Colors.Dark.xaml と揃える） -->
    <LinearGradientBrush x:Key="BgBrush" StartPoint="0,0" EndPoint="0.35,1">
        <GradientStop Color="#FFF6FA" Offset="0" />
        <GradientStop Color="#FFDDEB" Offset="0.5" />
        <GradientStop Color="#FFC4DC" Offset="1" />
    </LinearGradientBrush>
    <!-- 設定などの別ウィンドウの背景（下に何も無いので不透明） -->
    <LinearGradientBrush x:Key="DialogBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFF9FB" Offset="0" />
        <GradientStop Color="#FFE6F0" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="PanelBrush" Color="#A6FFFFFF" />
    <SolidColorBrush x:Key="Panel2Brush" Color="#C7FFFFFF" />
    <SolidColorBrush x:Key="Panel3Brush" Color="#D9FFE4EF" />
    <SolidColorBrush x:Key="LineBrush" Color="#99F4BFD5" />
    <SolidColorBrush x:Key="Line2Brush" Color="#F0AFCB" />
    <SolidColorBrush x:Key="TextBrush" Color="#5A2241" />
    <SolidColorBrush x:Key="SubBrush" Color="#77395C" />
    <SolidColorBrush x:Key="MutedBrush" Color="#9A587D" />
    <SolidColorBrush x:Key="DimBrush" Color="#B07A98" />
    <!-- アクセントはつやのあるピンクのボタン -->
    <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFA3CA" Offset="0" />
        <GradientStop Color="#FF74AA" Offset="0.48" />
        <GradientStop Color="#F25591" Offset="0.52" />
        <GradientStop Color="#FA6BA1" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentHoverBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFBAD7" Offset="0" />
        <GradientStop Color="#FF88B7" Offset="0.48" />
        <GradientStop Color="#F76A9F" Offset="0.52" />
        <GradientStop Color="#FD80AE" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SelectedRowBrush" Color="#CCFFD1E3" />
    <!-- 左の機種一覧で選んでいる機種（一覧の選択より濃く） -->
    <SolidColorBrush x:Key="SystemSelectedBrush" Color="#E6FFADCB" />
    <SolidColorBrush x:Key="OkBgBrush" Color="#DDF4E6" />
    <SolidColorBrush x:Key="OkFgBrush" Color="#15803D" />
    <SolidColorBrush x:Key="WarnBgBrush" Color="#FFF1CC" />
    <SolidColorBrush x:Key="WarnFgBrush" Color="#9A5B05" />
    <SolidColorBrush x:Key="ErrBgBrush" Color="#FDE0E0" />
    <SolidColorBrush x:Key="ErrFgBrush" Color="#B91C1C" />
    <!-- 切り替えボタンの選択中（白文字が乗る）-->
    <SolidColorBrush x:Key="SegOnBrush" Color="#DD5F93" />
    <!-- 切り替えボタンを並べた枠の地 -->
    <SolidColorBrush x:Key="SegGroupBrush" Color="#FFE0ED" />
    <!-- 入力欄・コンボボックスの地 -->
    <SolidColorBrush x:Key="InputBrush" Color="#E6FFFFFF" />
    <SolidColorBrush x:Key="FooterBrush" Color="#80FFFFFF" />
    <SolidColorBrush x:Key="HeaderRowBrush" Color="#A6FFE6F0" />
    <SolidColorBrush x:Key="HeaderLineBrush" Color="#F3BED4" />
    <!-- 普通のボタン：上がつやっと光る白いボタン -->
    <LinearGradientBrush x:Key="ButtonBgBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F2FFFFFF" Offset="0" />
        <GradientStop Color="#D9FFFFFF" Offset="0.5" />
        <GradientStop Color="#B3FFE8F1" Offset="0.52" />
        <GradientStop Color="#CCFFF4F8" Offset="1" />
    </LinearGradientBrush>

    <!-- 機種アイコン：機種の色の丸い粒にハイライト -->
    <!-- 1 のとき、機種の色で塗った水玉に白いアイコンを重ねる -->
    <sys:Double x:Key="SystemIconFilled">1</sys:Double>
    <CornerRadius x:Key="SystemIconRadius">22</CornerRadius>
    <RadialGradientBrush x:Key="SystemIconBgBrush" GradientOrigin="0.35,0.25" Center="0.45,0.4" RadiusX="0.75" RadiusY="0.75">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#FFE9F2" Offset="0.6" />
        <GradientStop Color="#F9BCD5" Offset="1" />
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="SystemIconGlossBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#CCFFFFFF" Offset="0" />
        <GradientStop Color="#1AFFFFFF" Offset="1" />
    </LinearGradientBrush>

    <!-- テレビ風プレビュー：白い縁＋つやのあるピンクの帯 -->
    <LinearGradientBrush x:Key="TvBezelBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0" /><GradientStop Color="#FFE7F0" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="TvBezelBorderBrush" Color="#F4B9D1" />
    <LinearGradientBrush x:Key="TvBandBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFA3CA" Offset="0" /><GradientStop Color="#FF74AA" Offset="0.48" />
        <GradientStop Color="#F25591" Offset="0.52" /><GradientStop Color="#FA6BA1" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="TvBandLineBrush" Color="#FFD3E5" />
    <SolidColorBrush x:Key="TvLedOffBrush" Color="#FFD6E6" />
    <SolidColorBrush x:Key="TvLogoBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TvSaveBgBrush" Color="#4D9C1C55" />
    <SolidColorBrush x:Key="TvSaveBorderBrush" Color="#B3FFFFFF" />
    <!-- ROM情報カード：ピンクの罫線のリングノート -->
    <sys:String x:Key="MemoHeaderText">memo</sys:String>
    <SolidColorBrush x:Key="MemoBgBrush" Color="#FFF7FA" />
    <SolidColorBrush x:Key="MemoBorderBrush" Color="#F4C2D6" />
    <SolidColorBrush x:Key="MemoLineBrush" Color="#F8D3E2" />
    <SolidColorBrush x:Key="MemoKeyBrush" Color="#A3628A" />
    <SolidColorBrush x:Key="MemoTextBrush" Color="#5A2543" />
    <SolidColorBrush x:Key="MemoTitleBrush" Color="#4A1A35" />
    <SolidColorBrush x:Key="MemoHeaderBrush" Color="#D88BAF" />
    <SolidColorBrush x:Key="MemoMarginBrush" Color="#F48DB6" />
    <SolidColorBrush x:Key="MemoFoldBrush" Color="#FAD6E5" />
    <!-- 折れた角の外側（パネルが半透明なので欠けさせない） -->
    <SolidColorBrush x:Key="MemoFoldCutBrush" Color="Transparent" />
    <DrawingBrush x:Key="MemoRingBrush" TileMode="Tile" Viewport="0,0,40,24" ViewportUnits="Absolute" Viewbox="0,0,40,24" ViewboxUnits="Absolute" Stretch="None">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H40 V24 H0 Z" />
                <GeometryDrawing Brush="#7A3A5C" Geometry="M21,12.5 A4,3 0 1 0 29,12.5 A4,3 0 1 0 21,12.5 Z" />
                <GeometryDrawing Geometry="M3.8,18.2 C1.8,9.2 13.8,4.2 23.8,11.2">
                    <GeometryDrawing.Pen><Pen Brush="#40602040" Thickness="3.2" StartLineCap="Round" EndLineCap="Round" /></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M3,17 C1,8 13,3 23,10">
                    <GeometryDrawing.Pen><Pen Brush="#F7A8C8" Thickness="2.6" StartLineCap="Round" EndLineCap="Round" /></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

</ResourceDictionary>
