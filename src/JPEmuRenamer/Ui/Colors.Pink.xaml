<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ピンク：淡い桜色に、ピンクのアクセント
         ソフトUI（ニューモーフィズム）：背景とパネルを同じ色にし、明るい影（左上）と暗い影（右下）で浮き上がり・へこみを表す。
         キーは6つのテーマで揃える（Ui/Theme.xaml と Views/*.xaml が DynamicResource で参照する） -->

    <!-- 地の色と、浮き上がり・へこみの影の色 -->
    <Color x:Key="SoftBaseColor">#F5E4EC</Color>
    <Color x:Key="SoftHiColor">#FFFFFF</Color>
    <Color x:Key="SoftLoColor">#D9B3C4</Color>
    <Color x:Key="AccentGlowColor">#EC5E95</Color>
    <SolidColorBrush x:Key="BgBrush" Color="#F5E4EC" />
    <SolidColorBrush x:Key="DialogBrush" Color="#F5E4EC" />
    <SolidColorBrush x:Key="PanelBrush" Color="#F5E4EC" />
    <SolidColorBrush x:Key="Panel2Brush" Color="#F5E4EC" />
    <SolidColorBrush x:Key="Panel3Brush" Color="#EFDAE4" />
    <SolidColorBrush x:Key="SegGroupBrush" Color="#F5E4EC" />
    <SolidColorBrush x:Key="InputBrush" Color="#F5E4EC" />
    <SolidColorBrush x:Key="FooterBrush" Color="Transparent" />
    <SolidColorBrush x:Key="HeaderRowBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ButtonBgBrush" Color="#F5E4EC" />
    <!-- へこんだ面：左上が少し暗い -->
    <LinearGradientBrush x:Key="SoftInsetBrush" StartPoint="0,0" EndPoint="0.7,1">
        <GradientStop Color="#EBD2DE" Offset="0" /><GradientStop Color="#F5E4EC" Offset="0.45" />
    </LinearGradientBrush>
    <!-- へこんだ面のふち（左上が暗く、右下が明るい） -->
    <LinearGradientBrush x:Key="SoftInsetEdgeBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#D9B3C4" Offset="0" /><GradientStop Color="#FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <!-- 浮き上がった小さな部品のふち（影を使わない軽い浮き上がり。左上が明るく、右下が暗い） -->
    <LinearGradientBrush x:Key="SoftRaisedEdgeBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFF" Offset="0" /><GradientStop Color="#D9B3C4" Offset="1" />
    </LinearGradientBrush>
    <!-- 影 -->
    <DropShadowEffect x:Key="SoftShadowDark" Color="#D9B3C4" Direction="315" ShadowDepth="5" BlurRadius="14" Opacity="1" />
    <DropShadowEffect x:Key="SoftShadowLight" Color="#FFFFFF" Direction="135" ShadowDepth="5" BlurRadius="14" Opacity="1" />
    <DropShadowEffect x:Key="SoftShadowDarkSmall" Color="#D9B3C4" Direction="315" ShadowDepth="3" BlurRadius="8" Opacity="1" />
    <DropShadowEffect x:Key="SoftShadowLightSmall" Color="#FFFFFF" Direction="135" ShadowDepth="3" BlurRadius="8" Opacity="1" />
    <DropShadowEffect x:Key="AccentGlow" Color="#EC5E95" Direction="270" ShadowDepth="4" BlurRadius="16" Opacity="0.55" />

    <!-- 線と文字 -->
    <SolidColorBrush x:Key="LineBrush" Color="#E6C9D6" />
    <SolidColorBrush x:Key="Line2Brush" Color="#D5B0C1" />
    <SolidColorBrush x:Key="HeaderLineBrush" Color="#E6C9D6" />
    <SolidColorBrush x:Key="TextBrush" Color="#5A2241" />
    <SolidColorBrush x:Key="SubBrush" Color="#7A3B5C" />
    <SolidColorBrush x:Key="MutedBrush" Color="#9C6A84" />
    <SolidColorBrush x:Key="DimBrush" Color="#AE8399" />

    <!-- アクセント（選んでいるもの・起動ボタン）：グラデーション -->
    <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#EC5E95" Offset="0" /><GradientStop Color="#FF9EC4" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentHoverBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F277A6" Offset="0" /><GradientStop Color="#FFB5D3" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#EC5E95" />
    <LinearGradientBrush x:Key="SegOnBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#EC5E95" Offset="0" /><GradientStop Color="#FF9EC4" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SelectedRowBrush" Color="#EFD3E0" />
    <SolidColorBrush x:Key="SystemSelectedBrush" Color="#F5E4EC" />

    <!-- 状態バッジ -->
    <SolidColorBrush x:Key="OkBgBrush" Color="#D9F1E3" />
    <SolidColorBrush x:Key="OkFgBrush" Color="#15803D" />
    <SolidColorBrush x:Key="WarnBgBrush" Color="#FBEECB" />
    <SolidColorBrush x:Key="WarnFgBrush" Color="#9A5B05" />
    <SolidColorBrush x:Key="ErrBgBrush" Color="#F9DADA" />
    <SolidColorBrush x:Key="ErrFgBrush" Color="#B91C1C" />

    <!-- 機種アイコン：地の色で小さく浮き上がる -->
    <sys:Double x:Key="SystemIconFilled">0</sys:Double>
    <CornerRadius x:Key="SystemIconRadius">14</CornerRadius>
    <SolidColorBrush x:Key="SystemIconBgBrush" Color="#F5E4EC" />
    <SolidColorBrush x:Key="SystemIconGlossBrush" Color="Transparent" />

    <!-- テレビ風プレビュー：地の色で浮き上がった枠に、へこんだ画面を埋め込む -->
    <SolidColorBrush x:Key="TvBezelBrush" Color="#F5E4EC" />
    <SolidColorBrush x:Key="TvBezelBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TvBandBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TvBandLineBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TvLedOffBrush" Color="#D9B3C4" />
    <SolidColorBrush x:Key="TvLogoBrush" Color="#9C6A84" />
    <SolidColorBrush x:Key="TvSaveBgBrush" Color="#F5E4EC" />
    <SolidColorBrush x:Key="TvSaveBorderBrush" Color="#D5B0C1" />

</ResourceDictionary>
