<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- メタル：銀色に近い灰色に、鋼のような青のアクセント
         ソフトUI（ニューモーフィズム）：背景とパネルを同じ色にし、明るい影（左上）と暗い影（右下）で浮き上がり・へこみを表す。
         キーは6つのテーマで揃える（Ui/Theme.xaml と Views/*.xaml が DynamicResource で参照する） -->

    <!-- 地の色と、浮き上がり・へこみの影の色 -->
    <Color x:Key="SoftBaseColor">#DCDFE4</Color>
    <Color x:Key="SoftHiColor">#FFFFFF</Color>
    <Color x:Key="SoftLoColor">#A6ADB8</Color>
    <Color x:Key="AccentGlowColor">#4F6D8F</Color>
    <SolidColorBrush x:Key="BgBrush" Color="#DCDFE4" />
    <SolidColorBrush x:Key="DialogBrush" Color="#DCDFE4" />
    <SolidColorBrush x:Key="PanelBrush" Color="#DCDFE4" />
    <SolidColorBrush x:Key="Panel2Brush" Color="#DCDFE4" />
    <SolidColorBrush x:Key="Panel3Brush" Color="#D3D6DC" />
    <SolidColorBrush x:Key="SegGroupBrush" Color="#DCDFE4" />
    <SolidColorBrush x:Key="InputBrush" Color="#DCDFE4" />
    <SolidColorBrush x:Key="FooterBrush" Color="Transparent" />
    <SolidColorBrush x:Key="HeaderRowBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ButtonBgBrush" Color="#DCDFE4" />
    <!-- へこんだ面：左上が少し暗い -->
    <LinearGradientBrush x:Key="SoftInsetBrush" StartPoint="0,0" EndPoint="0.7,1">
        <GradientStop Color="#CBCFD6" Offset="0" /><GradientStop Color="#DCDFE4" Offset="0.45" />
    </LinearGradientBrush>
    <!-- へこんだ面のふち（左上が暗く、右下が明るい） -->
    <LinearGradientBrush x:Key="SoftInsetEdgeBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#A6ADB8" Offset="0" /><GradientStop Color="#FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <!-- 浮き上がった小さな部品のふち（影を使わない軽い浮き上がり。左上が明るく、右下が暗い） -->
    <LinearGradientBrush x:Key="SoftRaisedEdgeBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFF" Offset="0" /><GradientStop Color="#A6ADB8" Offset="1" />
    </LinearGradientBrush>
    <!-- 影 -->
    <DropShadowEffect x:Key="SoftShadowDark" Color="#A6ADB8" Direction="315" ShadowDepth="5" BlurRadius="14" Opacity="1" />
    <DropShadowEffect x:Key="SoftShadowLight" Color="#FFFFFF" Direction="135" ShadowDepth="5" BlurRadius="14" Opacity="1" />
    <DropShadowEffect x:Key="SoftShadowDarkSmall" Color="#A6ADB8" Direction="315" ShadowDepth="3" BlurRadius="8" Opacity="1" />
    <DropShadowEffect x:Key="SoftShadowLightSmall" Color="#FFFFFF" Direction="135" ShadowDepth="3" BlurRadius="8" Opacity="1" />
    <DropShadowEffect x:Key="AccentGlow" Color="#4F6D8F" Direction="270" ShadowDepth="4" BlurRadius="16" Opacity="0.55" />

    <!-- 線と文字 -->
    <SolidColorBrush x:Key="LineBrush" Color="#C4C9D0" />
    <SolidColorBrush x:Key="Line2Brush" Color="#ADB3BC" />
    <SolidColorBrush x:Key="HeaderLineBrush" Color="#C4C9D0" />
    <SolidColorBrush x:Key="TextBrush" Color="#1B2027" />
    <SolidColorBrush x:Key="SubBrush" Color="#3E4553" />
    <SolidColorBrush x:Key="MutedBrush" Color="#6B7280" />
    <SolidColorBrush x:Key="DimBrush" Color="#7C8494" />

    <!-- アクセント（選んでいるもの・起動ボタン）：グラデーション -->
    <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4F6D8F" Offset="0" /><GradientStop Color="#86A6C8" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentHoverBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#5E7FA3" Offset="0" /><GradientStop Color="#9AB7D6" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#4F6D8F" />
    <LinearGradientBrush x:Key="SegOnBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4F6D8F" Offset="0" /><GradientStop Color="#86A6C8" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SelectedRowBrush" Color="#CDD3DB" />
    <SolidColorBrush x:Key="SystemSelectedBrush" Color="#DCDFE4" />

    <!-- 状態バッジ -->
    <SolidColorBrush x:Key="OkBgBrush" Color="#D3ECDD" />
    <SolidColorBrush x:Key="OkFgBrush" Color="#16733F" />
    <SolidColorBrush x:Key="WarnBgBrush" Color="#F3EACB" />
    <SolidColorBrush x:Key="WarnFgBrush" Color="#8A5A06" />
    <SolidColorBrush x:Key="ErrBgBrush" Color="#F3DADA" />
    <SolidColorBrush x:Key="ErrFgBrush" Color="#A61B1B" />

    <!-- 機種アイコン：地の色で小さく浮き上がる -->
    <sys:Double x:Key="SystemIconFilled">0</sys:Double>
    <CornerRadius x:Key="SystemIconRadius">14</CornerRadius>
    <SolidColorBrush x:Key="SystemIconBgBrush" Color="#DCDFE4" />
    <SolidColorBrush x:Key="SystemIconGlossBrush" Color="Transparent" />

    <!-- テレビ風プレビュー：地の色で浮き上がった枠に、へこんだ画面を埋め込む -->
    <SolidColorBrush x:Key="TvBezelBrush" Color="#DCDFE4" />
    <SolidColorBrush x:Key="TvBezelBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TvBandBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TvBandLineBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TvLedOffBrush" Color="#A6ADB8" />
    <SolidColorBrush x:Key="TvLogoBrush" Color="#6B7280" />
    <SolidColorBrush x:Key="TvSaveBgBrush" Color="#DCDFE4" />
    <SolidColorBrush x:Key="TvSaveBorderBrush" Color="#ADB3BC" />

</ResourceDictionary>
