<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ライト：青みのある淡い灰色に、水色から緑のアクセント
         ソフトUI（ニューモーフィズム）：背景とパネルを同じ色にし、明るい影（左上）と暗い影（右下）で浮き上がり・へこみを表す。
         キーは6つのテーマで揃える（Ui/Theme.xaml と Views/*.xaml が DynamicResource で参照する） -->

    <!-- 地の色と、浮き上がり・へこみの影の色 -->
    <Color x:Key="SoftBaseColor">#E4E9F0</Color>
    <Color x:Key="SoftHiColor">#FFFFFF</Color>
    <Color x:Key="SoftLoColor">#B8C2D0</Color>
    <Color x:Key="AccentGlowColor">#22B8CF</Color>
    <SolidColorBrush x:Key="BgBrush" Color="#E4E9F0" />
    <SolidColorBrush x:Key="DialogBrush" Color="#E4E9F0" />
    <SolidColorBrush x:Key="PanelBrush" Color="#E4E9F0" />
    <SolidColorBrush x:Key="Panel2Brush" Color="#E4E9F0" />
    <SolidColorBrush x:Key="Panel3Brush" Color="#DCE2EA" />
    <SolidColorBrush x:Key="SegGroupBrush" Color="#E4E9F0" />
    <SolidColorBrush x:Key="InputBrush" Color="#E4E9F0" />
    <SolidColorBrush x:Key="FooterBrush" Color="Transparent" />
    <SolidColorBrush x:Key="HeaderRowBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ButtonBgBrush" Color="#E4E9F0" />
    <!-- へこんだ面：左上が少し暗い -->
    <LinearGradientBrush x:Key="SoftInsetBrush" StartPoint="0,0" EndPoint="0.7,1">
        <GradientStop Color="#D3DAE4" Offset="0" /><GradientStop Color="#E4E9F0" Offset="0.45" />
    </LinearGradientBrush>
    <!-- へこんだ面のふち（左上が暗く、右下が明るい） -->
    <LinearGradientBrush x:Key="SoftInsetEdgeBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#B8C2D0" Offset="0" /><GradientStop Color="#FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <!-- 浮き上がった小さな部品のふち（影を使わない軽い浮き上がり。左上が明るく、右下が暗い） -->
    <LinearGradientBrush x:Key="SoftRaisedEdgeBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFF" Offset="0" /><GradientStop Color="#B8C2D0" Offset="1" />
    </LinearGradientBrush>
    <!-- 影 -->
    <DropShadowEffect x:Key="SoftShadowDark" Color="#B8C2D0" Direction="315" ShadowDepth="5" BlurRadius="14" Opacity="1" />
    <DropShadowEffect x:Key="SoftShadowLight" Color="#FFFFFF" Direction="135" ShadowDepth="5" BlurRadius="14" Opacity="1" />
    <DropShadowEffect x:Key="SoftShadowDarkSmall" Color="#B8C2D0" Direction="315" ShadowDepth="3" BlurRadius="8" Opacity="1" />
    <DropShadowEffect x:Key="SoftShadowLightSmall" Color="#FFFFFF" Direction="135" ShadowDepth="3" BlurRadius="8" Opacity="1" />
    <DropShadowEffect x:Key="AccentGlow" Color="#22B8CF" Direction="270" ShadowDepth="4" BlurRadius="16" Opacity="0.55" />

    <!-- 線と文字 -->
    <SolidColorBrush x:Key="LineBrush" Color="#CDD4DE" />
    <SolidColorBrush x:Key="Line2Brush" Color="#B8C1CD" />
    <SolidColorBrush x:Key="HeaderLineBrush" Color="#CDD4DE" />
    <SolidColorBrush x:Key="TextBrush" Color="#2E3A4C" />
    <SolidColorBrush x:Key="SubBrush" Color="#4A5668" />
    <SolidColorBrush x:Key="MutedBrush" Color="#7A8699" />
    <SolidColorBrush x:Key="DimBrush" Color="#8C97A8" />

    <!-- アクセント（選んでいるもの・起動ボタン）：グラデーション -->
    <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#22B8CF" Offset="0" /><GradientStop Color="#3DD6A0" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentHoverBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3CC6DA" Offset="0" /><GradientStop Color="#58E0AE" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#22B8CF" />
    <LinearGradientBrush x:Key="SegOnBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#22B8CF" Offset="0" /><GradientStop Color="#3DD6A0" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SelectedRowBrush" Color="#D7E2EC" />
    <SolidColorBrush x:Key="SystemSelectedBrush" Color="#E4E9F0" />

    <!-- 状態バッジ -->
    <SolidColorBrush x:Key="OkBgBrush" Color="#D2F2E5" />
    <SolidColorBrush x:Key="OkFgBrush" Color="#1F8A63" />
    <SolidColorBrush x:Key="WarnBgBrush" Color="#FBEFC9" />
    <SolidColorBrush x:Key="WarnFgBrush" Color="#9A6A06" />
    <SolidColorBrush x:Key="ErrBgBrush" Color="#F8DADA" />
    <SolidColorBrush x:Key="ErrFgBrush" Color="#B42323" />

    <!-- 機種アイコン：地の色で小さく浮き上がる -->
    <sys:Double x:Key="SystemIconFilled">0</sys:Double>
    <CornerRadius x:Key="SystemIconRadius">14</CornerRadius>
    <SolidColorBrush x:Key="SystemIconBgBrush" Color="#E4E9F0" />
    <SolidColorBrush x:Key="SystemIconGlossBrush" Color="Transparent" />

    <!-- テレビ風プレビュー：地の色で浮き上がった枠に、へこんだ画面を埋め込む -->
    <SolidColorBrush x:Key="TvBezelBrush" Color="#E4E9F0" />
    <SolidColorBrush x:Key="TvBezelBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TvBandBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TvBandLineBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TvLedOffBrush" Color="#B8C2D0" />
    <SolidColorBrush x:Key="TvLogoBrush" Color="#7A8699" />
    <SolidColorBrush x:Key="TvSaveBgBrush" Color="#E4E9F0" />
    <SolidColorBrush x:Key="TvSaveBorderBrush" Color="#B8C1CD" />

</ResourceDictionary>
