<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ライトモードの色（ダークモードは Colors.Dark.xaml。キーは両方で揃える） -->
    <SolidColorBrush x:Key="BgBrush" Color="#F3F4F7" />
    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Panel2Brush" Color="#F7F8FA" />
    <SolidColorBrush x:Key="Panel3Brush" Color="#E9ECF1" />
    <SolidColorBrush x:Key="LineBrush" Color="#DFE2E8" />
    <SolidColorBrush x:Key="Line2Brush" Color="#C7CCD5" />
    <SolidColorBrush x:Key="TextBrush" Color="#1C2028" />
    <SolidColorBrush x:Key="SubBrush" Color="#3E4553" />
    <SolidColorBrush x:Key="MutedBrush" Color="#6B7280" />
    <SolidColorBrush x:Key="DimBrush" Color="#7C8494" />
    <SolidColorBrush x:Key="AccentBrush" Color="#E5484D" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#D63B40" />
    <SolidColorBrush x:Key="SelectedRowBrush" Color="#FCE4E5" />
    <SolidColorBrush x:Key="OkBgBrush" Color="#DCF4E5" />
    <SolidColorBrush x:Key="OkFgBrush" Color="#15803D" />
    <SolidColorBrush x:Key="WarnBgBrush" Color="#FDF1C7" />
    <SolidColorBrush x:Key="WarnFgBrush" Color="#A16207" />
    <SolidColorBrush x:Key="ErrBgBrush" Color="#FDE2E2" />
    <SolidColorBrush x:Key="ErrFgBrush" Color="#B91C1C" />
    <!-- 切り替えボタンの選択中（白文字が乗る）-->
    <SolidColorBrush x:Key="SegOnBrush" Color="#5A6170" />
    <!-- 切り替えボタンを並べた枠の地 -->
    <SolidColorBrush x:Key="SegGroupBrush" Color="#F3F4F7" />
    <!-- 入力欄・コンボボックスの地 -->
    <SolidColorBrush x:Key="InputBrush" Color="#F3F4F7" />
    <SolidColorBrush x:Key="FooterBrush" Color="#ECEEF2" />
    <SolidColorBrush x:Key="HeaderRowBrush" Color="#F1F3F6" />
    <SolidColorBrush x:Key="HeaderLineBrush" Color="#D5D9E0" />

    <!-- 設定などの別ウィンドウの背景 -->
    <SolidColorBrush x:Key="DialogBrush" Color="#FFFFFF" />
    <!-- 普通のボタンの地（アクアモードだけつやのある白） -->
    <SolidColorBrush x:Key="ButtonBgBrush" Color="Transparent" />
    <!-- 機種アイコン（アクアモードだけ丸い水玉） -->
    <!-- 1 のとき、機種の色で塗った水玉に白いアイコンを重ねる -->
    <sys:Double x:Key="SystemIconFilled">0</sys:Double>
    <CornerRadius x:Key="SystemIconRadius">10</CornerRadius>
    <SolidColorBrush x:Key="SystemIconBgBrush" Color="#F7F8FA" />
    <SolidColorBrush x:Key="SystemIconGlossBrush" Color="Transparent" />
    <!-- テレビ風プレビュー：白い縁＋明るいシルバーの帯 -->
    <LinearGradientBrush x:Key="TvBezelBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0" /><GradientStop Color="#EEF0F3" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="TvBezelBorderBrush" Color="#D3D7DE" />
    <LinearGradientBrush x:Key="TvBandBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E9EBEE" Offset="0" /><GradientStop Color="#CDD1D7" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="TvBandLineBrush" Color="#F7F8FA" />
    <SolidColorBrush x:Key="TvLedOffBrush" Color="#9AA0A8" />
    <SolidColorBrush x:Key="TvLogoBrush" Color="#5A6170" />
    <SolidColorBrush x:Key="TvSaveBgBrush" Color="#F3F4F6" />
    <SolidColorBrush x:Key="TvSaveBorderBrush" Color="#B4BAC3" />
    <!-- ROM情報カード：クリーム色のリングノート -->
    <sys:String x:Key="MemoHeaderText">memo</sys:String>
    <SolidColorBrush x:Key="MemoBgBrush" Color="#EFEBDD" />
    <SolidColorBrush x:Key="MemoBorderBrush" Color="#D8D2BF" />
    <SolidColorBrush x:Key="MemoLineBrush" Color="#CFC8B3" />
    <SolidColorBrush x:Key="MemoKeyBrush" Color="#8A856F" />
    <SolidColorBrush x:Key="MemoTextBrush" Color="#3B3A35" />
    <SolidColorBrush x:Key="MemoTitleBrush" Color="#2F2E2A" />
    <SolidColorBrush x:Key="MemoHeaderBrush" Color="#9A9583" />
    <SolidColorBrush x:Key="MemoMarginBrush" Color="#E2A3A0" />
    <SolidColorBrush x:Key="MemoFoldBrush" Color="#D6CFB9" />
    <!-- 折れた角の外側（パネルの色で角を欠けさせる） -->
    <SolidColorBrush x:Key="MemoFoldCutBrush" Color="#FFFFFF" />
    <DrawingBrush x:Key="MemoRingBrush" TileMode="Tile" Viewport="0,0,40,24" ViewportUnits="Absolute" Viewbox="0,0,40,24" ViewboxUnits="Absolute" Stretch="None">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H40 V24 H0 Z" />
                <GeometryDrawing Brush="#4A4636" Geometry="M21,12.5 A4,3 0 1 0 29,12.5 A4,3 0 1 0 21,12.5 Z" />
                <GeometryDrawing Geometry="M3.8,18.2 C1.8,9.2 13.8,4.2 23.8,11.2">
                    <GeometryDrawing.Pen><Pen Brush="#40000000" Thickness="3.2" StartLineCap="Round" EndLineCap="Round" /></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M3,17 C1,8 13,3 23,10">
                    <GeometryDrawing.Pen><Pen Brush="#A9ADB4" Thickness="2.6" StartLineCap="Round" EndLineCap="Round" /></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

</ResourceDictionary>
