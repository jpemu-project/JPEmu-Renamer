<Window x:Class="JPEmuRenamer.Views.PlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JPEmu Renamer" Width="800" Height="640" MinWidth="320" MinHeight="240"
        Background="Black" Foreground="{DynamicResource TextBrush}" FontFamily="{StaticResource UiFont}"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        Closing="OnClosing" Closed="OnClosed" SizeChanged="OnSizeChanged" Deactivated="OnDeactivated">
    <Grid x:Name="Root" Background="Black" MouseMove="OnPointerMove" MouseLeftButtonDown="OnPointerDown"
          MouseLeftButtonUp="OnPointerUp" MouseLeave="OnPointerMove" LostMouseCapture="OnPointerMove">
        <Image x:Name="Screen" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Fill"
               RenderOptions.BitmapScalingMode="NearestNeighbor" SnapsToDevicePixels="True" />

        <!-- 読み込み中・エラー -->
        <StackPanel x:Name="StatusPanel" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource SubBrush}" FontSize="16" TextWrapping="Wrap" TextAlignment="Center" />
            <Button x:Name="StatusClose" Margin="0,18,0,0" HorizontalAlignment="Center" MinWidth="120" Visibility="Collapsed" Click="OnStatusClose" />
        </StackPanel>

        <!-- 画面上のメッセージ -->
        <Border x:Name="OsdBorder" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14" Padding="12,6"
                Background="#C0101318" CornerRadius="8" Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock x:Name="OsdText" Foreground="White" FontSize="15" />
        </Border>

        <!-- プレイ中のメニュー -->
        <Grid x:Name="MenuLayer" Background="#8C000000" Visibility="Collapsed">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="360" Padding="8,14"
                    Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="14">
                <StackPanel>
                    <TextBlock x:Name="MenuTitle" FontSize="18" FontWeight="SemiBold" Margin="16,2,16,4" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                    <TextBlock x:Name="MenuSub" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="16,0,16,10" />
                    <ListBox x:Name="MenuList" Background="Transparent" BorderThickness="0" FontSize="15"
                             MouseUp="OnMenuMouseUp" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="16,9" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="6,1">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Panel3Brush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}" />
                                                    <Setter Property="Foreground" Value="White" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <TextBlock x:Name="MenuHint" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="16,10,16,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
