<Window x:Class="JPEmuRenamer.Views.SnapshotBatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:JPEmuRenamer.Services"
        Title="{Binding [SnapBatchTitle], Source={x:Static s:Loc.Instance}}"
        Width="640" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="14" UseLayoutRounding="True"
        Closing="OnClosing">
    <StackPanel Margin="24,18,24,20">
        <TextBlock x:Name="IntroText" Foreground="{StaticResource SubBrush}" TextWrapping="Wrap" />
        <CheckBox x:Name="SkipExisting" Margin="0,14,0,0" IsChecked="True"
                  Content="{Binding [SnapBatchSkipExisting], Source={x:Static s:Loc.Instance}}" />

        <Border Margin="0,16,0,0" Background="{StaticResource BgBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="10"
                HorizontalAlignment="Center">
            <Grid Width="320" Height="240">
                <TextBlock x:Name="ShotText" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Image x:Name="ShotImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
            </Grid>
        </Border>

        <TextBlock x:Name="ProgressText" Margin="0,14,0,0" TextTrimming="CharacterEllipsis" />
        <ProgressBar x:Name="Progress" Height="6" Margin="0,8,0,0" Maximum="1" />
        <TextBlock x:Name="ResultText" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="StartButton" Style="{StaticResource AccentButton}" Click="OnStart" MinWidth="120" Margin="0,0,10,0" />
            <Button x:Name="StopButton" Click="OnStop" MinWidth="100" Margin="0,0,10,0" Visibility="Collapsed" />
            <Button x:Name="CloseButton" IsCancel="True" Click="OnCloseClick" MinWidth="100" />
        </StackPanel>
    </StackPanel>
</Window>
