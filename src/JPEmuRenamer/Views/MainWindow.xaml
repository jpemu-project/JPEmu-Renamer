<Window x:Class="JPEmuRenamer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:JPEmuRenamer.Services"
        Title="JPEmu Renamer" Icon="/Assets/logo.png" Width="1280" Height="800" MinWidth="760" MinHeight="480"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="{Binding FontSize}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
        PreviewMouseWheel="OnPreviewMouseWheel" Closing="OnClosing">

    <Window.Resources>
        <!-- タイトル一覧（Slaunch風：線で区切り、1行おきに色を変える） -->
        <Style x:Key="GameRow" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Bd" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}"
                                    BorderThickness="0,0,0,1" Padding="14,5">
                                <ContentPresenter />
                            </Border>
                            <Rectangle x:Name="Mark" Width="4" HorizontalAlignment="Left" Fill="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Panel2Brush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Panel3Brush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedRowBrush}" />
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SystemRow" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="10,8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Panel2Brush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Panel3Brush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GameTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusKey}" Value="Missing">
                    <Setter Property="Foreground" Value="{DynamicResource DimBrush}" />
                    <Setter Property="FontWeight" Value="Normal" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusDot" TargetType="Border">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="#6B7280" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusKey}" Value="Match">
                    <Setter Property="Background" Value="{DynamicResource OkFgBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKey}" Value="NameDiff">
                    <Setter Property="Background" Value="{DynamicResource WarnFgBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKey}" Value="Duplicate">
                    <Setter Property="Background" Value="{DynamicResource ErrFgBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKey}" Value="Missing">
                    <Setter Property="Background" Value="Transparent" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- タイトルの右クリック（別の方法で起動など） -->
        <ContextMenu x:Key="GameMenu" x:Shared="False"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="{Binding [MenuLaunchCore], Source={x:Static s:Loc.Instance}}" Command="{Binding LaunchWithCommand}" CommandParameter="Core" />
            <MenuItem Header="{Binding [MenuLaunchExternal], Source={x:Static s:Loc.Instance}}" Command="{Binding LaunchWithCommand}" CommandParameter="External" />
            <Separator />
            <MenuItem Header="{Binding [MenuGameSettings], Source={x:Static s:Loc.Instance}}" Command="{Binding OpenPlaySettingsCommand}" CommandParameter="Game" />
            <MenuItem Header="{Binding [MenuSystemSettings], Source={x:Static s:Loc.Instance}}" Command="{Binding OpenPlaySettingsCommand}" CommandParameter="System" />
            <Separator />
            <MenuItem Header="{Binding [MenuSnapshotBatch], Source={x:Static s:Loc.Instance}}" Command="{Binding CreateSnapshotsCommand}" />
            <Separator />
            <MenuItem Header="{Binding [OpenFolder], Source={x:Static s:Loc.Instance}}" Command="{Binding OpenFolderCommand}" />
        </ContextMenu>
    </Window.Resources>

    <Grid>
        <Grid.LayoutTransform>
            <ScaleTransform ScaleX="{Binding UiScale}" ScaleY="{Binding UiScale}" />
        </Grid.LayoutTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <Border Grid.Row="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="16,6">
            <Border.Resources>
                <!-- ヘッダーのボタンは低めにして、一覧に場所をゆずる -->
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="MinHeight" Value="32" />
                    <Setter Property="Padding" Value="14,4" />
                </Style>
            </Border.Resources>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 公式サイトの見出しと同じ筆記体（Assets/Fonts に同梱、OFL）。
                         ロゴと同じく、タイトルの真ん中の下に赤・黒・赤の丸を置く（黒は文字色にしてダーク系テーマでも見えるようにする） -->
                    <Grid Margin="4,0,20,0" VerticalAlignment="Center">
                        <TextBlock Text="JPEmu Renamer" FontFamily="pack://application:,,,/Assets/Fonts/#Great Vibes" FontSize="26" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-3">
                            <Ellipse Width="5" Height="5" Fill="#E5484D" />
                            <Ellipse Width="5" Height="5" Fill="{DynamicResource TextBrush}" Margin="3,0" />
                            <Ellipse Width="5" Height="5" Fill="#E5484D" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <Border Grid.Column="1" Style="{StaticResource SegGroup}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton GroupName="Mode" Style="{StaticResource SegButton}" Tag="{DynamicResource AccentBrush}"
                                     IsChecked="{Binding IsPlayMode, Mode=TwoWay}"
                                     Content="{Binding [Play], Source={x:Static s:Loc.Instance}}" />
                        <RadioButton GroupName="Mode" Style="{StaticResource SegButton}" Tag="{DynamicResource AccentBrush}"
                                     IsChecked="{Binding IsManageMode, Mode=TwoWay}"
                                     Content="{Binding [Manage], Source={x:Static s:Loc.Instance}}" />
                    </StackPanel>
                </Border>

                <!-- 検索欄は長くなりすぎないよう幅に上限をつけ、左に寄せる -->
                <Grid Grid.Column="2" Margin="16,0" VerticalAlignment="Center">
                    <!-- 左の列だけに置き、最大 420 まで。ウィンドウが狭いときは縮む -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100*" MaxWidth="420" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}" Padding="34,5,8,5" />
                    <Path Data="M6,1 A5,5 0 1 1 5.99,1 M10,10 L14,14" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.6"
                          Width="16" Height="16" HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False" />
                    <TextBlock Text="{Binding [Search], Source={x:Static s:Loc.Instance}}" Foreground="{DynamicResource MutedBrush}"
                               Margin="36,0,10,0" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- ツール（機種の追加は左の一覧の下にある） -->
                <Button x:Name="ToolsButton" Grid.Column="3" Click="OnTools" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding [Tools], Source={x:Static s:Loc.Instance}}" />
                        <TextBlock Text="▾" Margin="6,0,0,0" Foreground="{DynamicResource MutedBrush}" />
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{Binding [ToolSaveAll], Source={x:Static s:Loc.Instance}}" Command="{Binding SaveGameListCommand}" CommandParameter="All" />
                            <MenuItem Header="{Binding [ToolSaveOwned], Source={x:Static s:Loc.Instance}}" Command="{Binding SaveGameListCommand}" CommandParameter="Owned" />
                            <MenuItem Header="{Binding [ToolSaveMissing], Source={x:Static s:Loc.Instance}}" Command="{Binding SaveGameListCommand}" CommandParameter="Missing" />
                            <Separator />
                            <MenuItem Header="{Binding [ToolExtractAll], Source={x:Static s:Loc.Instance}}" Command="{Binding ExtractAllRomsCommand}" />
                            <MenuItem Header="{Binding [ToolCompressAll], Source={x:Static s:Loc.Instance}}" Command="{Binding CompressAllRomsCommand}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button Grid.Column="4" Command="{Binding OpenAppSettingsCommand}" Content="{Binding [Settings], Source={x:Static s:Loc.Instance}}" />
                <Button Grid.Column="5" Click="OnHelp" Content="{Binding [Help], Source={x:Static s:Loc.Instance}}" Margin="10,0,0,0"
                        ToolTip="{Binding [HelpTip], Source={x:Static s:Loc.Instance}}" />
            </Grid>
        </Border>

        <!-- 本体 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" MinWidth="200" />
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition x:Name="DetailColumn" Width="456" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <!-- 機種一覧 -->
            <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0" Padding="12,16">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding [Systems], Source={x:Static s:Loc.Instance}}" Style="{StaticResource Muted}" FontSize="12" Margin="10,0,0,8" />
                    <Button DockPanel.Dock="Bottom" Command="{Binding AddSystemCommand}" Content="{Binding [AddSystem], Source={x:Static s:Loc.Instance}}" Margin="0,8,0,0" />
                    <!-- ドラッグ＆ドロップで並べ替えられる -->
                    <ListBox x:Name="SystemList" ItemsSource="{Binding Systems}" SelectedItem="{Binding SelectedSystem}" ItemContainerStyle="{StaticResource SystemRow}"
                             AllowDrop="True" PreviewMouseLeftButtonDown="OnSystemMouseDown" PreviewMouseMove="OnSystemMouseMove"
                             DragOver="OnSystemDragOver" Drop="OnSystemDrop"
                             Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="44" Height="44" CornerRadius="{DynamicResource SystemIconRadius}" Background="{DynamicResource SystemIconBgBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                                        <Grid>
                                            <!-- アクアモード：機種の色の水玉に白いアイコン（ほかのモードでは透明） -->
                                            <Ellipse Fill="{Binding IconBrush}" Opacity="{DynamicResource SystemIconFilled}" IsHitTestVisible="False" />
                                            <Viewbox Width="32" Height="32" Visibility="{Binding HasCustomIcon, Converter={StaticResource InvBoolToVis}}">
                                                <Canvas Width="48" Height="48">
                                                    <Path Data="{Binding Icon}" Stroke="{Binding IconBrush}" StrokeThickness="2.6"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                    <Path Data="{Binding Icon}" Stroke="White" StrokeThickness="2.6" Opacity="{DynamicResource SystemIconFilled}"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                </Canvas>
                                            </Viewbox>
                                            <Ellipse Width="32" Height="18" VerticalAlignment="Top" Margin="0,2,0,0" Fill="{DynamicResource SystemIconGlossBrush}" IsHitTestVisible="False" />
                                            <Image Source="{Binding CustomIcon}" Width="34" Height="34" Visibility="{Binding HasCustomIcon, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding CountText}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- タイトル一覧／管理表 -->
            <Grid Grid.Column="1" Margin="14,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 機種名と本数は左の機種一覧に出ているので、ここは絞り込みと機種の設定だけ -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="1" Style="{StaticResource SegGroup}" Margin="8,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton GroupName="Filter" Style="{StaticResource SegButton}" Padding="12,4"
                                         IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=All}"
                                         Content="{Binding [FilterAll], Source={x:Static s:Loc.Instance}}" />
                            <RadioButton GroupName="Filter" Style="{StaticResource SegButton}" Padding="12,4"
                                         IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=Owned}"
                                         Content="{Binding [FilterOwned], Source={x:Static s:Loc.Instance}}" />
                            <RadioButton GroupName="Filter" Style="{StaticResource SegButton}" Padding="12,4"
                                         IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=Missing}"
                                         Content="{Binding [FilterMissing], Source={x:Static s:Loc.Instance}}" />
                        </StackPanel>
                    </Border>
                    <!-- 並び替え：押すと並び順の一覧が開く -->
                    <Button Grid.Column="2" Content="{Binding SortButtonText}" Click="OnSortClick" Padding="12,4" MinHeight="34" Margin="0,0,8,0" />
                    <Button Grid.Column="3" Command="{Binding EditSystemCommand}" Content="{Binding [EditSystem], Source={x:Static s:Loc.Instance}}" Padding="12,4" MinHeight="34" />
                </Grid>

                <!-- 未設定のとき -->
                <Border Grid.Row="1" Visibility="{Binding NeedsSetup, Converter={StaticResource BoolToVis}}"
                        Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="32">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding [NoSystemSetup], Source={x:Static s:Loc.Instance}}" TextAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SubBrush}" LineHeight="26" />
                        <Button Style="{StaticResource AccentButton}" Command="{Binding EditSystemCommand}" HorizontalAlignment="Center" Margin="0,20,0,0"
                                Content="{Binding [EditSystem], Source={x:Static s:Loc.Instance}}" />
                    </StackPanel>
                </Border>

                <!-- 機種が1つも無いとき（最初の起動時）：見出しと一覧の上にかぶせる -->
                <Border Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="10" Background="{DynamicResource BgBrush}"
                        Visibility="{Binding HasNoSystems, Converter={StaticResource BoolToVis}}">
                    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="32">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
                            <TextBlock Text="{Binding [NoSystems], Source={x:Static s:Loc.Instance}}" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" />
                            <TextBlock Text="{Binding [NoSystemsHint], Source={x:Static s:Loc.Instance}}" TextAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{DynamicResource SubBrush}" LineHeight="26" Margin="0,12,0,0" />
                            <Button Style="{StaticResource AccentButton}" Command="{Binding AddSystemCommand}" HorizontalAlignment="Center" Margin="0,22,0,0"
                                    Content="{Binding [AddSystem], Source={x:Static s:Loc.Instance}}" />
                        </StackPanel>
                    </Border>
                </Border>

                <Grid Grid.Row="1" Visibility="{Binding NeedsSetup, Converter={StaticResource InvBoolToVis}}">
                    <!-- 遊ぶ（リスト） -->
                    <Border Visibility="{Binding IsManageMode, Converter={StaticResource InvBoolToVis}}"
                            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderRowBrush}" BorderBrush="{DynamicResource HeaderLineBrush}" BorderThickness="0,0,0,1" Padding="14,5">
                                <Grid TextElement.Foreground="{DynamicResource MutedBrush}" TextElement.FontSize="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="112" />
                                        <ColumnDefinition Width="88" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="{Binding [ColTitle], Source={x:Static s:Loc.Instance}}" />
                                    <TextBlock Grid.Column="2" Text="{Binding [ColPublisher], Source={x:Static s:Loc.Instance}}" />
                                    <TextBlock Grid.Column="3" Text="{Binding [ColStatus], Source={x:Static s:Loc.Instance}}" HorizontalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ListBox x:Name="GameList" ItemsSource="{Binding ItemsView}" SelectedItem="{Binding SelectedItem}"
                                     ItemContainerStyle="{StaticResource GameRow}" AlternationCount="2"
                                     Background="{DynamicResource PanelBrush}" BorderThickness="0"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     MouseDoubleClick="OnGameDoubleClick" KeyDown="OnGameKeyDown"
                                     ContextMenu="{StaticResource GameMenu}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="112" />
                                                <ColumnDefinition Width="88" />
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource StatusDot}" HorizontalAlignment="Left" />
                                            <!-- 発売地域の国旗（設定で消せる）とタイトル -->
                                            <DockPanel Grid.Column="1">
                                                <Image DockPanel.Dock="Left" Source="{Binding FlagImage}" Height="12" Margin="0,0,7,0" VerticalAlignment="Center"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource GameTitle}" FontSize="15" />
                                            </DockPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Publisher}" Style="{StaticResource Muted}" FontSize="13" FontWeight="Normal" TextTrimming="CharacterEllipsis" ToolTip="{Binding Publisher}" Margin="0,0,6,0" />
                                            <Border Grid.Column="3" Style="{StaticResource StatusBadge}">
                                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusText}" FontWeight="Normal" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <!-- 整理（管理表） -->
                    <DataGrid Visibility="{Binding IsManageMode, Converter={StaticResource BoolToVis}}"
                              ItemsSource="{Binding ItemsView}" SelectedItem="{Binding SelectedItem}" IsReadOnly="True"
                              EnableRowVirtualization="True" ContextMenu="{StaticResource GameMenu}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="44">
                                <DataGridTemplateColumn.Header>
                                    <!-- リネーム候補（名前違い）をまとめて選ぶ。表示中の候補の状態に合わせて、チェック・一部・なしを表示する -->
                                    <CheckBox IsChecked="{Binding DataContext.AllChecked, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}"
                                              IsEnabled="{Binding DataContext.HasRenameCandidates, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              ToolTip="{Binding [SelectAllTip], Source={x:Static s:Loc.Instance}}" />
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding CanRename}" HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="100" Header="{Binding [ColStatus], Source={x:Static s:Loc.Instance}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource StatusBadge}">
                                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusText}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Width="2*" Binding="{Binding CurrentFileName}" Header="{Binding [ColCurrent], Source={x:Static s:Loc.Instance}}" />
                            <DataGridTemplateColumn Width="2*" Header="{Binding [ColTarget], Source={x:Static s:Loc.Instance}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <Image DockPanel.Dock="Left" Source="{Binding FlagImage}" Height="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding TargetText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Width="90" Binding="{Binding CrcText}" Header="{Binding [ColCrc], Source={x:Static s:Loc.Instance}}" FontFamily="Consolas" />
                            <DataGridTextColumn Width="80" Binding="{Binding SizeText}" Header="{Binding [ColSize], Source={x:Static s:Loc.Instance}}" />
                            <DataGridTextColumn Width="64" Binding="{Binding FormatText}" Header="{Binding [ColFormat], Source={x:Static s:Loc.Instance}}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>

            <!-- 詳細 -->
            <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0" Padding="20,16">
                <Grid>
                    <!-- 遊ぶ：プレビューと起動 -->
                    <DockPanel Visibility="{Binding IsManageMode, Converter={StaticResource InvBoolToVis}}">
                        <!-- テレビ風の枠：縁と下の帯の色はテーマごと（Colors.*.xaml の Tv*） -->
                        <Border DockPanel.Dock="Top" Height="312" CornerRadius="10" Background="{DynamicResource TvBezelBrush}" BorderBrush="{DynamicResource TvBezelBorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="24" />
                                </Grid.RowDefinitions>
                                <Border Margin="9,9,9,8" Background="Black" CornerRadius="2">
                                    <Grid ClipToBounds="True">
                                        <!-- 待機中：左が黒に溶ける4色の横縞 -->
                                        <UniformGrid Rows="4" Margin="0,4">
                                            <UniformGrid.Style>
                                                <Style TargetType="UniformGrid">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Source, ElementName=PreviewImage}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </UniformGrid.Style>
                                            <Border Margin="0,3">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="Black" Offset="0.08" /><GradientStop Color="#BFE0FF" Offset="0.55" /><GradientStop Color="#E6F3FF" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <Border Margin="0,3">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="Black" Offset="0.08" /><GradientStop Color="#E3102B" Offset="0.55" /><GradientStop Color="#FF1A3A" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <Border Margin="0,3">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="Black" Offset="0.08" /><GradientStop Color="#00C98F" Offset="0.55" /><GradientStop Color="#00F0B0" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <Border Margin="0,3">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="Black" Offset="0.08" /><GradientStop Color="#1747D8" Offset="0.55" /><GradientStop Color="#2A6CFF" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                        </UniformGrid>
                                        <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" MouseLeftButtonUp="OnPreviewClick" />
                                        <!-- 案内文：縞の下寄りに半透明の帯で -->
                                        <Border VerticalAlignment="Bottom" Margin="0,0,0,10" Padding="12,4">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#00000000" Offset="0" /><GradientStop Color="#A6000000" Offset="0.25" />
                                                    <GradientStop Color="#A6000000" Offset="0.75" /><GradientStop Color="#00000000" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=PreviewText}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock x:Name="PreviewText" Foreground="#E9ECF1" FontSize="12"
                                                       TextAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <!-- 下の帯：ランプ・ロゴ・保存ボタン -->
                                <Border Grid.Row="1" CornerRadius="0,0,9,9" Background="{DynamicResource TvBandBrush}" BorderBrush="{DynamicResource TvBandLineBrush}" BorderThickness="0,1,0,0">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <Ellipse Width="5" Height="5" Margin="0,0,6,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#39D17A" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Source, ElementName=PreviewImage}" Value="{x:Null}">
                                                                <Setter Property="Fill" Value="#D9473F" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <Ellipse Width="5" Height="5" Margin="0,0,6,0" Fill="{DynamicResource TvLedOffBrush}" />
                                            <Ellipse Width="5" Height="5" Fill="{DynamicResource TvLedOffBrush}" />
                                        </StackPanel>
                                        <!-- ヘッダーのタイトルと同じ筆記体（Great Vibes） -->
                                        <TextBlock Text="JPEmu" FontFamily="pack://application:,,,/Assets/Fonts/#Great Vibes" FontSize="15" Foreground="{DynamicResource TvLogoBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0" />
                                        <Button x:Name="PreviewSaveButton" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                                                Padding="6,0" MinHeight="0" Height="17" MaxWidth="96" FontSize="10" Visibility="Collapsed"
                                                Background="{DynamicResource TvSaveBgBrush}" Foreground="{DynamicResource TvLogoBrush}" BorderBrush="{DynamicResource TvSaveBorderBrush}"
                                                Content="{Binding [PreviewSave], Source={x:Static s:Loc.Instance}}" Click="OnPreviewSave" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                        <StackPanel DockPanel.Dock="Bottom">
                            <Button Style="{StaticResource AccentButton}" Command="{Binding LaunchCommand}" Content="{Binding LaunchButtonText}"
                                    MinHeight="50" FontSize="16" IsEnabled="{Binding HasSelection}" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Command="{Binding OpenPlaySettingsCommand}" CommandParameter="Game"
                                        Content="{Binding [PlaySettingsButton], Source={x:Static s:Loc.Instance}}" IsEnabled="{Binding SelectedItem.IsOwned}" />
                                <Button Grid.Column="2" Command="{Binding OpenFolderCommand}" Content="{Binding [OpenFolder], Source={x:Static s:Loc.Instance}}"
                                        IsEnabled="{Binding SelectedItem.IsOwned}" />
                            </Grid>
                        </StackPanel>
                        <!-- ROM情報：リングで綴じたノート風のカード -->
                        <ScrollViewer Margin="0,12,0,12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                            <Grid Margin="12,0,0,0" DataContext="{Binding SelectedItem}">
                                <Grid.Resources>
                                    <!-- 罫線つきの1行。値が空の行は隠す -->
                                    <Style x:Key="InfoRow" TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{DynamicResource MemoLineBrush}" />
                                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                                        <Setter Property="MinHeight" Value="24" />
                                        <Setter Property="Padding" Value="0,3,0,2" />
                                        <Style.Triggers>
                                            <Trigger Property="Tag" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                    <Style x:Key="InfoKey" TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource MemoKeyBrush}" />
                                        <Setter Property="Width" Value="100" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    </Style>
                                </Grid.Resources>
                                <Border Background="{DynamicResource MemoBgBrush}" BorderBrush="{DynamicResource MemoBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="28,8,14,8">
                                    <StackPanel TextElement.FontSize="13" TextElement.Foreground="{DynamicResource MemoTextBrush}">
                                        <TextBlock Text="{DynamicResource MemoHeaderText}" FontSize="10" Foreground="{DynamicResource MemoHeaderBrush}" HorizontalAlignment="Right" Margin="0,0,0,2" />
                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource MemoTitleBrush}" TextWrapping="Wrap" Margin="0,-4,0,4" />
                                        <Border Style="{StaticResource InfoRow}" Tag="{Binding StatusText}">
                                            <DockPanel>
                                                <TextBlock Style="{StaticResource InfoKey}" Text="{Binding [ColStatus], Source={x:Static s:Loc.Instance}}" />
                                                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
                                            </DockPanel>
                                        </Border>
                                        <Border Style="{StaticResource InfoRow}" Tag="{Binding Publisher}">
                                            <DockPanel>
                                                <TextBlock Style="{StaticResource InfoKey}" Text="{Binding [InfoPublisher], Source={x:Static s:Loc.Instance}}" />
                                                <TextBlock Text="{Binding Publisher}" TextWrapping="Wrap" />
                                            </DockPanel>
                                        </Border>
                                        <Border Style="{StaticResource InfoRow}" Tag="{Binding Genre}">
                                            <DockPanel>
                                                <TextBlock Style="{StaticResource InfoKey}" Text="{Binding [InfoGenre], Source={x:Static s:Loc.Instance}}" />
                                                <TextBlock Text="{Binding Genre}" TextWrapping="Wrap" />
                                            </DockPanel>
                                        </Border>
                                        <Border Style="{StaticResource InfoRow}" Tag="{Binding ReleaseDate}">
                                            <DockPanel>
                                                <TextBlock Style="{StaticResource InfoKey}" Text="{Binding [InfoRelease], Source={x:Static s:Loc.Instance}}" />
                                                <TextBlock Text="{Binding ReleaseDate}" TextWrapping="Wrap" />
                                            </DockPanel>
                                        </Border>
                                        <Border Style="{StaticResource InfoRow}" Tag="{Binding Price}">
                                            <DockPanel>
                                                <TextBlock Style="{StaticResource InfoKey}" Text="{Binding [InfoPrice], Source={x:Static s:Loc.Instance}}" />
                                                <TextBlock Text="{Binding Price}" TextWrapping="Wrap" />
                                            </DockPanel>
                                        </Border>
                                        <Border Style="{StaticResource InfoRow}" Tag="{Binding CrcText}">
                                            <DockPanel>
                                                <TextBlock Style="{StaticResource InfoKey}" Text="CRC" />
                                                <TextBlock Text="{Binding CrcText}" FontFamily="Consolas" />
                                            </DockPanel>
                                        </Border>
                                        <Border Style="{StaticResource InfoRow}" Tag="{Binding CurrentFileName}">
                                            <DockPanel>
                                                <TextBlock Style="{StaticResource InfoKey}" Text="{Binding [InfoFile], Source={x:Static s:Loc.Instance}}" />
                                                <TextBlock Text="{Binding CurrentFileName}" TextWrapping="Wrap" />
                                            </DockPanel>
                                        </Border>
                                        <Border Style="{StaticResource InfoRow}" Tag="{Binding Comment}">
                                            <DockPanel>
                                                <TextBlock Style="{StaticResource InfoKey}" Text="{Binding [InfoComment], Source={x:Static s:Loc.Instance}}" />
                                                <TextBlock Text="{Binding Comment}" TextWrapping="Wrap" />
                                            </DockPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <!-- ライトモードのノートだけに出る赤い余白線と、右下の折れ -->
                                <Rectangle Width="1" HorizontalAlignment="Left" Margin="22,1,0,1" Fill="{DynamicResource MemoMarginBrush}" IsHitTestVisible="False" />
                                <Canvas Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False">
                                    <Polygon Points="0,18 18,0 18,18" Fill="{DynamicResource MemoFoldCutBrush}" />
                                    <Polygon Points="0,18 0,0 18,0" Fill="{DynamicResource MemoFoldBrush}" />
                                </Canvas>
                                <!-- 綴じリング：ページの外から穴へ通るワイヤーを縦に並べる（形と色は Colors.*.xaml の MemoRingBrush） -->
                                <Rectangle Width="40" HorizontalAlignment="Left" Margin="-12,8,0,6" IsHitTestVisible="False" Fill="{DynamicResource MemoRingBrush}" />
                            </Grid>
                        </ScrollViewer>
                    </DockPanel>

                    <!-- 整理：リネーム前後の比較 -->
                    <StackPanel Visibility="{Binding IsManageMode, Converter={StaticResource BoolToVis}}">
                        <Border Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="14"
                                DataContext="{Binding SelectedItem}">
                            <StackPanel>
                                <TextBlock Text="{Binding [Before], Source={x:Static s:Loc.Instance}}" Style="{StaticResource Muted}" FontSize="12" />
                                <TextBlock Text="{Binding CurrentFileName}" Foreground="{DynamicResource SubBrush}" TextWrapping="Wrap" Margin="0,4,0,12" />
                                <TextBlock Text="{Binding [After], Source={x:Static s:Loc.Instance}}" Style="{StaticResource Muted}" FontSize="12" />
                                <TextBlock Text="{Binding TargetText}" Foreground="{DynamicResource WarnFgBrush}" FontWeight="Bold" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding [RenameNote], Source={x:Static s:Loc.Instance}}" Foreground="{DynamicResource SubBrush}"
                                   TextWrapping="Wrap" LineHeight="24" Margin="0,14,0,0" FontSize="13" />

                        <!-- DATに無いファイルの移動（機種ごと）。「リネーム」と同時に行い、「取り消し」で元に戻る -->
                        <Border Background="{DynamicResource Panel2Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10"
                                Padding="14" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding [UnknownSection], Source={x:Static s:Loc.Instance}}" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,8" />
                                <CheckBox IsChecked="{Binding MoveUnknown}" FontSize="13"
                                          Content="{Binding [MoveUnknown], Source={x:Static s:Loc.Instance}}" />
                                <DockPanel Margin="0,10,0,0">
                                    <Button DockPanel.Dock="Right" Click="OnBrowseUnknown" Margin="8,0,0,0" Padding="12,4" MinHeight="34"
                                            Content="{Binding [Browse], Source={x:Static s:Loc.Instance}}" />
                                    <TextBox Text="{Binding UnknownFolder, UpdateSourceTrigger=LostFocus}" />
                                </DockPanel>
                                <TextBlock Text="{Binding [UnknownHint], Source={x:Static s:Loc.Instance}}" Foreground="{DynamicResource MutedBrush}"
                                           FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- フッター -->
        <Border Grid.Row="2" Background="{DynamicResource FooterBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Muted}" FontSize="12" />
                    <ProgressBar IsIndeterminate="True" Margin="0,6,0,0" MaxWidth="300" HorizontalAlignment="Left" Width="300"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding [Footer], Source={x:Static s:Loc.Instance}}" Style="{StaticResource Muted}" FontSize="12"
                           Visibility="{Binding IsManageMode, Converter={StaticResource InvBoolToVis}}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding IsManageMode, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding SelectedCountText}" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <Button Command="{Binding RescanCommand}" Content="{Binding [Rescan], Source={x:Static s:Loc.Instance}}" Margin="0,0,8,0" />
                    <Button Command="{Binding UndoCommand}" Content="{Binding [Undo], Source={x:Static s:Loc.Instance}}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource AccentButton}" Command="{Binding RunRenameCommand}" Content="{Binding [RunRename], Source={x:Static s:Loc.Instance}}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
