<Window x:Class="JPEmuRenamer.Views.SystemEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:JPEmuRenamer.Services"
        Title="{Binding [EditSystem], Source={x:Static s:Loc.Instance}}"
        Width="680" Height="760" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource DialogBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="14" UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource FooterBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel>
                <Button x:Name="DeleteButton" DockPanel.Dock="Left" Click="OnDelete" Foreground="{DynamicResource ErrFgBrush}"
                        Content="{Binding [Delete], Source={x:Static s:Loc.Instance}}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button IsCancel="True" Content="{Binding [Cancel], Source={x:Static s:Loc.Instance}}" Margin="0,0,10,0" MinWidth="100" />
                    <Button IsDefault="True" Style="{StaticResource AccentButton}" Click="OnOk" Content="{Binding [Ok], Source={x:Static s:Loc.Instance}}" MinWidth="120" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,8,24,20">
            <StackPanel>
                <TextBlock Style="{StaticResource Label}" Text="{Binding [Preset], Source={x:Static s:Loc.Instance}}" />
                <ComboBox x:Name="PresetBox" SelectionChanged="OnPresetChanged" />

                <TextBlock Style="{StaticResource Label}" Text="{Binding [Name], Source={x:Static s:Loc.Instance}}" />
                <TextBox x:Name="NameBox" LostFocus="OnNameOrExtChanged" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}" Text="{Binding [Icon], Source={x:Static s:Loc.Instance}}" />
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="10" Background="{DynamicResource Panel2Brush}" Margin="0,0,10,0">
                                <Viewbox Width="28" Height="28">
                                    <Canvas Width="48" Height="48">
                                        <Path x:Name="IconPreview" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            <ComboBox x:Name="IconBox" SelectionChanged="OnIconChanged" VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource Label}" Text="{Binding [IconColor], Source={x:Static s:Loc.Instance}}" />
                        <TextBox x:Name="ColorBox" TextChanged="OnColorChanged" MinHeight="40" />
                    </StackPanel>
                </Grid>

                <TextBlock Style="{StaticResource Label}" Text="{Binding [CustomIcon], Source={x:Static s:Loc.Instance}}" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Click="OnBrowseIcon" Content="{Binding [Browse], Source={x:Static s:Loc.Instance}}" Margin="8,0,0,0" />
                    <TextBox x:Name="CustomIconBox" />
                </DockPanel>

                <TextBlock Style="{StaticResource Label}" Text="{Binding [DatFile], Source={x:Static s:Loc.Instance}}" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Click="OnBrowseDat" Content="{Binding [Browse], Source={x:Static s:Loc.Instance}}" Margin="8,0,0,0" />
                    <TextBox x:Name="DatBox" />
                </DockPanel>

                <TextBlock Style="{StaticResource Label}" Text="{Binding [RomFolder], Source={x:Static s:Loc.Instance}}" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Click="OnBrowseRom" Content="{Binding [Browse], Source={x:Static s:Loc.Instance}}" Margin="8,0,0,0" />
                    <TextBox x:Name="RomBox" />
                </DockPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}" Text="{Binding [Extensions], Source={x:Static s:Loc.Instance}}" />
                        <TextBox x:Name="ExtBox" LostFocus="OnNameOrExtChanged" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource Label}" Text="{Binding [HeaderMode], Source={x:Static s:Loc.Instance}}" />
                        <ComboBox x:Name="HeaderBox" />
                    </StackPanel>
                </Grid>

                <CheckBox x:Name="DisplayOnlyCheck" Margin="0,14,0,0">
                    <TextBlock Text="{Binding [DisplayRenameOnly], Source={x:Static s:Loc.Instance}}" TextWrapping="Wrap" />
                </CheckBox>

                <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,20,0,0" />

                <TextBlock Style="{StaticResource Label}" Text="{Binding [LaunchMode], Source={x:Static s:Loc.Instance}}" />
                <ComboBox x:Name="LaunchModeBox" />

                <TextBlock Style="{StaticResource Label}" Text="{Binding [BuiltinCore], Source={x:Static s:Loc.Instance}}" />
                <DockPanel>
                    <Button x:Name="CoreDownloadButton" DockPanel.Dock="Right" Click="OnDownloadCore" Margin="8,0,0,0" MinWidth="130" />
                    <ComboBox x:Name="CoreBox" SelectionChanged="OnCoreChanged" />
                </DockPanel>
                <TextBlock x:Name="CoreStatus" Foreground="{DynamicResource MutedBrush}" FontSize="12.5" Margin="0,6,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="BiosHint" Foreground="{DynamicResource MutedBrush}" FontSize="12.5" Margin="0,4,0,0" TextWrapping="Wrap" />

                <TextBlock Style="{StaticResource Label}" Text="{Binding [EmulatorPath], Source={x:Static s:Loc.Instance}}" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Click="OnBrowseExe" Content="{Binding [Browse], Source={x:Static s:Loc.Instance}}" Margin="8,0,0,0" />
                    <TextBox x:Name="ExeBox" />
                </DockPanel>

                <TextBlock Style="{StaticResource Label}" Text="{Binding [EmulatorArgs], Source={x:Static s:Loc.Instance}}" />
                <TextBox x:Name="ArgsBox" FontFamily="Consolas" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
